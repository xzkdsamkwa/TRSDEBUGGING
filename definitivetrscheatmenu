    local function addToggle(parent,text,default,cb,opts)
        opts=opts or {}
        local btn=new("TextButton",{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.row,Text="",AutoButtonColor=false,LayoutOrder=nextLO(),Parent=parent},{corner(6)})
        local label=new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(10,0),Size=UDim2.new(1,-142,1,0),Text=text,TextColor3=T.text,Font=Enum.Font.GothamMedium,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,Parent=btn})

        local keyBtn
        local obj={State=false,Kind="toggle",Name=text,Key=nil,KeyButton=nil}

        if opts.keybind~=false then
            keyBtn=new("TextButton",{
                AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-50,0.5,0),
                Size=UDim2.fromOffset(58,20),BackgroundColor3=T.off,
                Text="NONE",TextColor3=T.dim,Font=Enum.Font.GothamBold,TextSize=10,
                AutoButtonColor=false,ZIndex=btn.ZIndex+1,Parent=btn
            },{corner(5)})
            obj.KeyButton=keyBtn

            local function refreshBindLabel()
                keyBtn.Text=obj.Key and obj.Key.Name or "NONE"
                keyBtn.TextColor3=obj.Key and T.text or T.dim
                keyBtn.BackgroundColor3=obj.Key and T.off or T.off
            end

            function obj:SetKey(key,silent)
                if key~=nil and typeof(key)~="EnumItem" then return false end
                if key and key.EnumType~=Enum.KeyCode then return false end
                self.Key=key
                refreshBindLabel()
                if opts.onKeyChanged then pcall(opts.onKeyChanged,key) end
                if not silent and key then notify(text.." keybind: "..key.Name,"info") end
                return true
            end

            track(keyBtn.Activated:Connect(function()
                uiPulse(keyBtn)
                bindMode={kind="toggle",obj=obj,button=keyBtn}
                keyBtn.Text="PRESS KEY"
                keyBtn.TextColor3=T.text
            end))

            local legacyKey=opts.key
            if legacyKey and typeof(legacyKey)=="EnumItem" then
                obj:SetKey(legacyKey,true)
            elseif type(legacyKey)=="string" and legacyKey~="" then
                local ok,k=pcall(function() return Enum.KeyCode[legacyKey] end)
                if ok and k then obj:SetKey(k,true) end
            end
        end

        local sw=new("Frame",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-8,0.5,0),Size=UDim2.fromOffset(34,16),BackgroundColor3=T.off,Parent=btn},{corner(8)})
        local knob=new("Frame",{Size=UDim2.fromOffset(12,12),Position=UDim2.fromOffset(2,2),BackgroundColor3=Color3.new(1,1,1),Parent=sw},{corner(6)})

        function obj:Set(v,silent)
            if self.State==v then return end self.State=v
            uiTween(sw,{BackgroundColor3=v and T.on or T.off},0.14)
            uiTween(knob,{Position=v and UDim2.fromOffset(20,2) or UDim2.fromOffset(2,2)},0.16)
            task.spawn(function() local ok,err=pcall(cb,v) if not ok then warn("[Mod] toggle '"..text.."' error: "..tostring(err)) end end)
            if not silent then notify((v and "Enabled: " or "Disabled: ")..esc(text),v and "success" or "neutral") end
        end

        track(btn.Activated:Connect(function() uiPulse(btn) obj:Set(not obj.State) end))
        toggles[#toggles+1]=obj
        toggleBindReg[text]=obj
        if opts.setting then settingsReg[opts.setting]=obj else toggleReg[text]=obj end
        if default then task.defer(function() obj:Set(true,true) end) end
        return obj
    end
    local function addSlider(parent,text,min,max,default,cb,opts)
        local holder=new("Frame",{Size=UDim2.new(1,0,0,42),BackgroundColor3=T.row,LayoutOrder=nextLO(),Parent=parent},{corner(6)})
        local lbl=new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(8,3),Size=UDim2.new(1,-16,0,14),Text=text,TextColor3=T.text,Font=Enum.Font.GothamMedium,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,Parent=holder})
        local bar=new("Frame",{Position=UDim2.new(0,8,0,26),Size=UDim2.new(1,-16,0,6),BackgroundColor3=T.off,Parent=holder},{corner(3)})
        local fill=new("Frame",{Size=UDim2.fromScale(0,1),BackgroundColor3=T.accent,BorderSizePixel=0,Parent=bar},{corner(3)})
        local hit=new("TextButton",{Position=UDim2.new(0,8,0,18),Size=UDim2.new(1,-16,0,22),BackgroundTransparency=1,Text="",Parent=holder})
        local obj={Value=default,Locked=false,Label=lbl,Kind="slider"}
        function obj:Set(v,silent)
            v=math.clamp(math.floor(v+0.5),min,max) self.Value=v
            fill.Size=UDim2.fromScale((v-min)/math.max(max-min,1),1)
            if not silent then cb(v) end
        end
        function obj:SetLocked(l)
            self.Locked=l holder.BackgroundTransparency=l and 0.5 or 0
            fill.BackgroundColor3=l and T.dim or T.accent lbl.TextColor3=l and T.dim or T.text
        end
        local dragging=false
        local function fromX(x) local rel=math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1) obj:Set(min+rel*(max-min)) end
        track(hit.InputBegan:Connect(function(i) if(i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) and not obj.Locked then dragging=true fromX(i.Position.X) end end))
        track(UIS.InputChanged:Connect(function(i) if dragging and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then fromX(i.Position.X) end end))
        track(UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end end))
        obj:Set(default,true)
        if opts and opts.setting then settingsReg[opts.setting]=obj elseif opts and opts.save then sliderReg[opts.save]=obj end
        return obj
    end

