    local function collectConfig()
        local data={schema=6,version=CONFIG.Version,lastSeenVersion=Saved.lastSeenVersion,settings={},toggles={},sliders={},keybinds={},farm={},webhook=(_G.__RS_webhookUrl or "")}
        for k,v in pairs(S) do data.settings[k]=v end
        for name,o in pairs(toggleReg) do data.toggles[name]=o.State end
        for name,o in pairs(sliderReg) do data.sliders[name]=o.Value end
        for name,o in pairs(toggleBindReg) do if o.Key then data.keybinds[name]=o.Key.Name end end
        data.farm={tool=RevFarm.tool,body=RevFarm.body,custom=RevFarm.customList} return data
    end

    local function applySaved(data,restoreFeatures)
        if type(data)~="table" then return end
        if type(data.settings)=="table" then
            for k,v in pairs(data.settings) do
                if S[k]~=nil and type(S[k])==type(v) then
                    S[k]=v
                    local o=settingsReg[k]
                    if o then
                        if o.Kind=="slider" then o:Set(v) else o:Set(v,true) end
                    end
                end
            end
        end

        do
            local ok,k=pcall(function() return Enum.KeyCode[S.ToggleKey] end)
            if ok and k then CONFIG.ToggleKey=k end
            if Drink.toggle and Drink.toggle.SetKey then
                Drink.toggle:SetKey(nil,true)
                if S.StaminaKey~="" then
                    local ok2,k2=pcall(function() return Enum.KeyCode[S.StaminaKey] end)
                    if ok2 and k2 then Drink.toggle:SetKey(k2,true) end
                end
            end
        end

        if type(data.keybinds)=="table" then
            for name,keyName in pairs(data.keybinds) do
                local o=toggleBindReg[name]
                if o and o.SetKey then
                    local ok,k=pcall(function() return Enum.KeyCode[keyName] end)
                    if ok and k then o:SetKey(k,true) end
                end
            end
        end

        if type(data.webhook)=="string" then _G.__RS_webhookUrl=data.webhook:gsub("%s+","") if webhookBox then webhookBox.Text=data.webhook end end
        if type(data.farm)=="table" then
            if type(data.farm.custom)=="table" then for _,n in ipairs(data.farm.custom) do if type(n)=="string" and n~="" then RevFarm.addToolRow(n,false,true) end end end
            if type(data.farm.tool)=="string" and data.farm.tool~="" then RevFarm.selectTool(data.farm.tool) end
            if type(data.farm.body)=="string" then RevFarm.setBody(data.farm.body) end
        end
        if restoreFeatures then
            if type(data.sliders)=="table" then for name,v in pairs(data.sliders) do local o=sliderReg[name] if o and type(v)=="number" then o:Set(v) end end end
            if type(data.toggles)=="table" then for name,v in pairs(data.toggles) do local o=toggleReg[name] if o and type(v)=="boolean" then o:Set(v,true) end end end
        end
        setTheme(S.Theme) applyLook() updateKeyLabels() themeRefresh()
    end

