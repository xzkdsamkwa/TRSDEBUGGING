    -- ============================================================
    local playerPage=addTab("Player")
    do
        local psOriginalHold,psStatus={},nil
        local function restorePS() for p,orig in pairs(psOriginalHold) do if p and p.Parent then pcall(function() p.HoldDuration=orig end) end end table.clear(psOriginalHold) end

        addSection(playerPage,"Power Station")
        addToggle(playerPage,"Instant Fix Power Station",false,function(v) flags.InstantFix=v if not v then restorePS() if psStatus then psStatus.Text="Idle" end end end)
        addButton(playerPage,"Fix Power Station now",function()
            local prompts,ps=powerStationPrompts() if not ps then psStatus.Text="PowerStation not found" notify("PowerStation not found","error") return end
