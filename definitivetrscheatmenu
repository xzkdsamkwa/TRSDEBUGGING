local function fadeOut(root,t)
    if not S.UIAnimations then root:Destroy() return end
    local ti=TweenInfo.new(t,Enum.EasingStyle.Quad)
    for _,d in ipairs(root:GetDescendants()) do
        local props={}
        if d:IsA("GuiObject") then props.BackgroundTransparency=1 end
        if d:IsA("TextLabel") or d:IsA("TextButton") then props.TextTransparency=1 end
        if d:IsA("UIStroke") then props.Transparency=1 end
        if next(props) then Tween:Create(d,ti,props):Play() end
    end
    Tween:Create(root,ti,{BackgroundTransparency=1}):Play() task.wait(t+0.05) root:Destroy()
end

local function runStartup()
    local applySaved=_G.__RS_applySaved
    local steps={
        {"Hooking services...",function() task.wait() end},
        {"Waiting for character...",function() local t0=tick() while alive and not getHRP() and tick()-t0<6 do task.wait(0.1) end end},
        {"Scanning for revenants...",function() end},
        {"Indexing golden scraps...",function() if getGolden then getGolden(true) end end},
        {"Restoring saved config...",function() if applySaved then applySaved(Saved,S.RestoreToggles) end end},
        {"Ready.",function() task.wait(0.1) end},
    }
    if not loadUI then for _,st_ in ipairs(steps) do pcall(st_[2]) end return end
    local skip=false
    track(loadUI.frame.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then skip=true end end))
    local shown,target=0,0
    local function pump(dur) local t0=tick() repeat local dt=RunService.Heartbeat:Wait() shown+=(target-shown)*math.min(1,dt*8) loadUI.fill.Size=UDim2.fromScale(shown,1) loadUI.pct.Text=("%d%%"):format(math.floor(shown*100+0.5)) until skip or tick()-t0>=dur or not alive end
    for i,st_ in ipairs(steps) do
        if not alive then return end loadUI.status.Text=st_[1] target=i/#steps
        local done=false task.spawn(function() pcall(st_[2]) done=true end)
        local t0=tick() repeat pump(0.03) until(done and(skip or tick()-t0>=0.25)) or not alive
    end
    target=1 pump(0.2) if alive then fadeOut(loadUI.frame,0.3) end
end

