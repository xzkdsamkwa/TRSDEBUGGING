                    notify(i.KeyCode.Name.." is reserved for the menu key","warn")
                    if mode.button then mode.button.Text=obj.Key and obj.Key.Name or "NONE" end
                else
                    local usedBy
                    for name,o in pairs(toggleBindReg) do
                        if o~=obj and o.Key==i.KeyCode then usedBy=name break end
                    end
                    if usedBy then
                        notify(i.KeyCode.Name.." is already bound to "..usedBy,"warn")
                        if mode.button then mode.button.Text=obj.Key and obj.Key.Name or "NONE" end
                    else
                        obj:SetKey(i.KeyCode)
                    end
                end
                updateKeyLabels()
                return
            end

            -- Global menu key
            if i.KeyCode==Enum.KeyCode.Escape then
                updateKeyLabels()
            elseif i.KeyCode==Enum.KeyCode.Backspace or i.KeyCode==Enum.KeyCode.Delete then
                notify("Menu key cannot be cleared","warn")
                updateKeyLabels()
            else
                local staminaKey
                for _,o in pairs(toggleBindReg) do if o.Key then staminaKey=o.Key end end
                if i.KeyCode==staminaKey then
                    notify(i.KeyCode.Name.." is used by a feature keybind","warn")
                else
                    CONFIG.ToggleKey,S.ToggleKey=i.KeyCode,i.KeyCode.Name
                    notify("Menu key: "..i.KeyCode.Name,"info")
                    updateKeyLabels()
                end
            end
            return
        end

        if not gp then
            for _,o in pairs(toggleBindReg) do
                if o.Key and i.KeyCode==o.Key then
                    o:Set(not o.State)
                    return
                end
            end
        end
    end))
end -- end window do

