local function attrText(inst)
    local keys={} for k in pairs(inst:GetAttributes()) do keys[#keys+1]=k end table.sort(keys)
    if #keys==0 then return '<font color="#888888">(no attributes)</font>' end
    local out={} for _,k in ipairs(keys) do out[#out+1]=('<font color="#9aa4ff">%s</font> = %s'):format(esc(k),esc(inst:GetAttribute(k))) end
    return table.concat(out,"\n")
end

