        if bindMode then
            if i.UserInputType~=Enum.UserInputType.Keyboard then return end
            local mode=bindMode
            bindMode=nil
            bindDone=tick()

            if mode.kind=="toggle" then
                local obj=mode.obj
                if not obj then return end

                if i.KeyCode==Enum.KeyCode.Escape then
                    if mode.button then
                        mode.button.Text=obj.Key and obj.Key.Name or "NONE"
                        mode.button.TextColor3=obj.Key and T.text or T.dim
                    end
                elseif i.KeyCode==Enum.KeyCode.Backspace or i.KeyCode==Enum.KeyCode.Delete then
                    obj:SetKey(nil)
