            if not lower:find(nameL,1,true) then return false end
            for _, kw in ipairs(LOTTO_CONFIG.WinKeywords) do
                if lower:find(kw,1,true) then return true end
            end
            return false
        end

        local lottoWon = false
        track(game:GetService("Players").LocalPlayer.Chatted:Connect(function(msg)
            if lottoState.running and chatIsWin(msg) then lottoWon=true end
        end))
        track(Players.PlayerAdded:Connect(function(p)
            track(p.Chatted:Connect(function(msg)
                if lottoState.running and chatIsWin(msg) then lottoWon=true end
            end))
        end))
        -- Retroactively hook existing players
        for _, p in ipairs(Players:GetPlayers()) do
            track(p.Chatted:Connect(function(msg)
                if lottoState.running and chatIsWin(msg) then lottoWon=true end
            end))
        end

        addSection(lottoPage,"Auto Lottery")

        local lottoIntervalSlider
        local lottoInterval = 1.0
        lottoIntervalSlider=addSlider(lottoPage,"Fire interval (s × 100)",100,125,100,function(v)
            lottoInterval=v/100
            lottoIntervalSlider.Label.Text=("Interval: %.2f s"):format(lottoInterval)
        end,{save="Lotto interval"})
        lottoIntervalSlider.Label.Text=("Interval: %.2f s"):format(lottoInterval)

        lottoState.toggle=addToggle(lottoPage,"Auto Lotto",false,function(v)
            lottoState.running=v
            if not v then
                lottoWon=false
                if lottoState.status then lottoState.status.Text="Idle" end
                notify("Auto Lotto stopped","neutral")
            else
                lottoWon=false
                notify("Auto Lotto started (priority over scrap farm)","farm")
            end
        end)

        addSection(lottoPage,"Stats")
        lottoState.status=addLabel(lottoPage,"Idle")

        task.spawn(function()
            local PROMPT_DISABLE_GRACE = 3
            local lastPromptSeen = {}

            while alive do
                if not lottoState.running then task.wait(0.3); continue end

                local hrp=getHRP()
                if not hrp then
                    lottoState.status.Text="Waiting for character..."
                    task.wait(0.5); continue
                end
                local part, pp, machineName = getAvailableMachine()

                if machineName then lastPromptSeen[machineName]=tick() end

                if not part or not pp then
                    lottoState.status.Text=flags.Farm and "No lottery machine available, scrap farm has control until one is ready." or "No lottery machine available, wait until one goes off cooldown."
                    task.wait(0.5); continue
                end

                -- Scrap farm yields as soon as we want control; give it a moment to finish its current step
                local waited=0
                while Share.scrapBusy and waited<2 and lottoState.running do
                    lottoState.status.Text="Waiting for scrap farm to yield..."
                    task.wait(0.05) waited+=0.05
                end
                hrp=getHRP()
                if not hrp then task.wait(0.2); continue end

                local promptCF = part.CFrame
                local offsetCF = promptCF
                hrp.CFrame = offsetCF + Vector3.new(0, 0, 1.5)
                hrp.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.1)
                pcall(function()
                    if pp.HoldDuration and pp.HoldDuration > 0 then
                        pp.HoldDuration = 0
                    end
                end)
                pcall(firePrompt, pp)
                lottoState.spins += 1

                -- Wait a tick then check if we got a tool named *ticket*
                task.wait(0.15)
                local ch = LP.Character
                if ch then
                    for _, tool in ipairs(ch:GetChildren()) do
                        if tool:IsA("Tool") and tool.Name:lower():find("ticket",1,true) then
                            fireSignal(tool.Activated, function() tool:Activate() end)
                            task.wait(0.05)
                            break
                        end
                    end
                    local bp = LP:FindFirstChildOfClass("Backpack")
                    if bp then
                        for _, tool in ipairs(bp:GetChildren()) do
                            if tool:IsA("Tool") and tool.Name:lower():find("ticket",1,true) then
                                local hum2 = ch:FindFirstChildOfClass("Humanoid")
                                if hum2 then pcall(function() hum2:EquipTool(tool) end) end
                                task.wait(0.1)
                                fireSignal(tool.Activated, function() tool:Activate() end)
                                task.wait(0.05)
                                fireSignal(tool.Deactivated, function() tool:Deactivate() end)
                                break
                            end
                        end
                    end
                end

                -- Check win
                if lottoWon then
                    lottoWon=false
                    lottoState.wins+=1
                    lottoState.lastWin=tick()
                    notify(("Lottery WIN #%d after %d spins!"):format(lottoState.wins,lottoState.spins),"farm")
                    local sw=_G.__RS_sendWebhook
                    if sw then sw("Lottery Win",{{name="Win #",value=tostring(lottoState.wins),inline=true},{name="Total spins",value=tostring(lottoState.spins),inline=true}},0xFFC828) end
                end

                -- Check if current machine prompt has gone dark for too long → switch
                local promptGone = not(pp and pp.Enabled and pp:IsDescendantOf(workspace))
                local lastSeen   = lastPromptSeen[machineName] or tick()
                if promptGone and tick()-lastSeen>PROMPT_DISABLE_GRACE then
                    notify("Machine "..tostring(machineName).." unavailable, switching","info")
                end

                lottoState.status.Text=("Machine: %s | Spins: %d | Wins: %d | Last win: %s"):format(
                    tostring(machineName),lottoState.spins,lottoState.wins,
                    lottoState.lastWin>0 and ("%ds ago"):format(math.floor(tick()-lottoState.lastWin)) or "never")

                task.wait(math.max(lottoInterval-0.2,0.05)) -- already spent ~0.2s in the logic above
            end
        end)

        addButton(lottoPage,"Reset stats",function()
            lottoState.wins=0 lottoState.spins=0 lottoState.lastWin=0
            notify("Lotto stats reset","neutral")
        end)
    end

    do
        local function normName(s) return(tostring(s):lower():gsub("[^%w]","")) end

        local function revPartFor(m)
            if not m then return nil end
            if RevFarm.body=="HumanoidRootPart" then
                return m:FindFirstChild("HumanoidRootPart") or partOf(m)
            end
            return m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or partOf(m)
        end

        local function hasForceField(m)
            if not m then return false end
            for _,v in ipairs(m:GetDescendants()) do
                if v:IsA("ForceField") then return true end
            end
            return false
        end

        local function findFarmTool()
            local want=normName(RevFarm.tool) if want=="" then return nil end local partial
            for _,container in ipairs({LP.Character,LP:FindFirstChildOfClass("Backpack")}) do
                if container then for _,t in ipairs(container:GetChildren()) do if t:IsA("Tool") then local n=normName(t.Name) if n==want then return t end if not partial and RevFarm.custom[want] and n:find(want,1,true) then partial=t end end end end
            end
            return partial
        end
        local function stopSwing() local ch=LP.Character local tool=ch and ch:FindFirstChildOfClass("Tool") if tool then fireSignal(tool.Deactivated,function() tool:Deactivate() end) end end

        -- Rev Farm uses real first-person while the lock is active so weapon scripts that
        -- read CurrentCamera/CFrame aim from the actual player view at the revenant.
        local revPrevCameraMode,revPrevCameraType=nil,nil
        local function engageRevCamera()
            if RevFarm.camHeld then return end
            local cam=workspace.CurrentCamera
            revPrevCameraMode=LP.CameraMode
            revPrevCameraType=cam and cam.CameraType or nil
            LP.CameraMode=Enum.CameraMode.LockFirstPerson
            if cam then cam.CameraType=Enum.CameraType.Custom end
            RevFarm.camHeld=true
        end
        local function releaseRevCamera()
            if not RevFarm.camHeld then return end
            RevFarm.camHeld=false
            LP.CameraMode=revPrevCameraMode or Enum.CameraMode.Classic
            local cam=workspace.CurrentCamera
            if cam then cam.CameraType=revPrevCameraType or Enum.CameraType.Custom end
            revPrevCameraMode,revPrevCameraType=nil,nil
        end

        addSection(revPage,"Auto Farm Revenant")
        RevFarm.toggle=addToggle(revPage,"Auto Farm Revenant",false,function(v)
            flags.RevFarm=v
            if not v then
                RevFarm.target=nil RevFarm.stuckTimer=0 RevFarm.ffWaiting=false
                releaseRevCamera() pcall(stopSwing)
                if RevFarm.status then RevFarm.status.Text="Idle" end
                reportRevEvent("Farm Stopped",nil,{{name="Session Kills",value=tostring(RevFarm.kills)}},0x888888)
            else RevFarm.kills=0 notify("Auto Farm started, tool: "..esc(RevFarm.tool),"farm") reportRevEvent("Farm Started",nil,{{name="Tool",value=RevFarm.tool,inline=true}},0x46C86E) end
        end)
        RevFarm.status=addLabel(revPage,"Idle")

        addSection(revPage,"Weapon")
        local toolHolder=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=nextLO(),Parent=revPage},{new("UIListLayout",{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder})})

        local function selectTool(name)
            RevFarm.tool=name local n=normName(name)
            for _,r in ipairs(RevFarm.rows) do r.btn.BackgroundColor3=(r.norm==n) and T.accent or T.row end
        end
        local function addToolRow(name,rec,custom)
            local n=normName(name) for _,r in ipairs(RevFarm.rows) do if r.norm==n then return r end end
            local btn=new("TextButton",{Size=UDim2.new(1,0,0,26),BackgroundColor3=T.row,Text="",AutoButtonColor=false,LayoutOrder=#RevFarm.rows+1,Parent=toolHolder},{corner(5)})
            new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(8,0),Size=UDim2.new(1,-100,1,0),Text=name,TextColor3=T.text,Font=Enum.Font.GothamMedium,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=btn})
            if rec then local tag=new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-6,0.5,0),Size=UDim2.fromOffset(88,14),BackgroundColor3=T.on,Text="RECOMMENDED",TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamBold,TextSize=9,Parent=btn},{corner(4)}) tag:SetAttribute("NoTheme",true)
            elseif custom then new("TextLabel",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-6,0.5,0),Size=UDim2.fromOffset(54,14),BackgroundColor3=T.off,Text="CUSTOM",TextColor3=T.text,Font=Enum.Font.GothamBold,TextSize=9,Parent=btn},{corner(4)}) end
            local row={name=name,norm=n,btn=btn}
            RevFarm.rows[#RevFarm.rows+1]=row
            if custom then RevFarm.custom[n]=true RevFarm.customList[#RevFarm.customList+1]=name end
            track(btn.Activated:Connect(function() selectTool(name) end)) return row
        end
        RevFarm.addToolRow,RevFarm.selectTool=addToolRow,selectTool

        for _,t in ipairs(CONFIG.RevenantTools) do addToolRow(t.name,t.rec,false) end
        selectTool(RevFarm.tool)

        local customBox
        customBox=addTextbox(revPage,"Custom tool name (Enter to add)",function(t)
            local name=t:match("^%s*(.-)%s*$") customBox.Text=""
            if not name or name=="" then return end addToolRow(name,false,true) selectTool(name) notify("Custom tool added: "..esc(name),"info")
        end)

        addSection(revPage,"Position & Camera")
        local bodyBtn
        RevFarm.setBody=function(b)
            if b~="Torso" and b~="HumanoidRootPart" then return end RevFarm.body=b
            local note=(b=="HumanoidRootPart") and " ⚠" or ""
            bodyBtn.Text=("Body target: %s%s"):format(b,note)
        end
        bodyBtn=addButton(revPage,"Body target: Torso",function() RevFarm.setBody(RevFarm.body=="Torso" and "HumanoidRootPart" or "Torso") end)
        addLabel(revPage,'<font color="#ffcc4d">! HumanoidRootPart: This might cause issues as\nthe RootPart is not updated on ragdolls.</font>')

        addToggle(revPage,"Lock camera to revenant",true,function(v) RevFarm.camAim=v if not v then releaseRevCamera() end end)
        local distSlider
        distSlider=addSlider(revPage,"Teleport distance",1,8,RevFarm.dist,function(v) RevFarm.dist=v distSlider.Label.Text=("Teleport dist: %d studs"):format(v) end,{save="Revenant farm distance"})
        distSlider.Label.Text=("Teleport dist: %d studs"):format(RevFarm.dist)

        addSection(revPage,"Kill Count")
        addButton(revPage,"Reset kill counter",function() RevFarm.kills=0 notify("Kill counter reset","neutral") end)

        pcall(function() RunService:UnbindFromRenderStep("RevFarmCam") end)
        RunService:BindToRenderStep("RevFarmCam",Enum.RenderPriority.Camera.Value+10,function()
            if not flags.RevFarm or not RevFarm.camAim then
                if RevFarm.camHeld then releaseRevCamera() end
                return
            end
            local cam=workspace.CurrentCamera local hrp=getHRP()
            local m=RevFarm.target
            local part=m and m:IsDescendantOf(workspace) and revPartFor(m)
            if not(cam and hrp and part) then releaseRevCamera() return end

            engageRevCamera()
            -- Keep the normal Roblox first-person camera active. Rotating the character
            -- instead of forcing a Scriptable camera makes weapon raycasts use the real
            -- first-person camera direction while preserving the old lock-on behavior.
            local targetPos=part.Position+Vector3.new(0,CONFIG.RevFarmAimYOffset or 1.5,0)
            local flatTarget=Vector3.new(targetPos.X,hrp.Position.Y,targetPos.Z)
            if (flatTarget-hrp.Position).Magnitude>0.05 then
                hrp.CFrame=CFrame.lookAt(hrp.Position,flatTarget)
            end
            -- Apply the final pitch/yaw to the real first-person camera after Roblox's
            -- normal camera update. Weapon raycasts that use Camera.CFrame now point
            -- directly at the same revenant the farm is targeting.
            cam.CFrame=CFrame.lookAt(cam.CFrame.Position,targetPos)
        end)

        RevFarm.ffWaiting=false

        -- If one of the dangerous/special hours starts while the farm is running,
        -- stop the farm and move to whichever configured teleport is farthest away.
        local revFarmStopHours={}
        for _,name in ipairs(CONFIG.RevFarmStopHours or {}) do
            revFarmStopHours[name]=true
        end

        local function getFarthestRevFarmTeleport()
            local hrp=getHRP()
            if not hrp then return nil,nil end

            local farthest,farthestDistance=nil,-math.huge
            for _,entry in ipairs(CONFIG.SpecificTeleports or {}) do
                local pos=entry and entry.pos
                if typeof(pos)=="Vector3" then
                    local distance=(pos-hrp.Position).Magnitude
                    if distance>farthestDistance then
                        farthest,farthestDistance=entry,distance
                    end
                end
            end
            return farthest,farthestDistance
        end

        local function stopRevFarmForHour(hourName)
            if not flags.RevFarm then return end

            local farthest,distance=getFarthestRevFarmTeleport()
            -- Use the normal toggle callback so all existing farm shutdown behavior
            -- (camera release, swing release, status, reporting, etc.) stays intact.
            if RevFarm.toggle then
                RevFarm.toggle:Set(false)
            else
                flags.RevFarm=false
                RevFarm.target=nil
                RevFarm.stuckTimer=0
                RevFarm.ffWaiting=false
                releaseRevCamera()
                pcall(stopSwing)
            end

            if farthest and farthest.pos then
                teleportTo(CFrame.new(farthest.pos))
                notify(("Auto Farm stopped for %s → %s"):format(esc(hourName),esc(farthest.label or "safe point")),"warn")
            else
                notify(("Auto Farm stopped for %s (no configured safe teleport)"):format(esc(hourName)),"warn")
            end
        end

        task.spawn(function()
            local lastHandledHour=""
            local lastHourState=false

            while alive do
                if not flags.RevFarm then
                    lastHandledHour=""
                    lastHourState=false
                    task.wait(0.25)
                    continue
                end

                local values=RS:FindFirstChild("Values")
                local hourActive=values and values:FindFirstChild("HourActive")
                local hourNameValue=hourActive and hourActive:FindFirstChild("HourName")
                local active=hourActive and hourActive.Value==true
                local hourName=hourNameValue and tostring(hourNameValue.Value) or ""

                if active and not lastHourState and hourName~="" and revFarmStopHours[hourName] and hourName~=lastHandledHour then
                    lastHandledHour=hourName
                    stopRevFarmForHour(hourName)
                elseif not active then
                    lastHourState=false
                end

                if active then
                    lastHourState=true
                end

                task.wait(0.1)
            end
        end)

        task.spawn(function()
            local SWING_INT   = CONFIG.AutoAttackInterval
            local EQUIP_DELAY = 1.5
            local STUCK_THRESH= 8
            local TP_INTERVAL = 0.05
            local lastTP      = 0
            local lastNotifyStuck = 0

            while alive do
                if not flags.RevFarm then task.wait(0.3); continue end

                local ch=LP.Character
                local hum=ch and ch:FindFirstChildOfClass("Humanoid")
                local hrp=getHRP()

                if not(hum and hrp and hum.Health>0) then
                    RevFarm.status.Text="Waiting for character..."
                    RevFarm.target=nil task.wait(0.5); continue
                end

                local tool=findFarmTool()
                if not tool then
                    RevFarm.status.Text=('Tool "%s" not found'):format(esc(RevFarm.tool))
                    task.wait(EQUIP_DELAY); continue
                elseif tool.Parent~=ch then
                    RevFarm.status.Text="Equipping "..esc(tool.Name)
                    local ok=pcall(function() hum:EquipTool(tool) end)
                    if not ok then
                        local cur=ch:FindFirstChildOfClass("Tool")
                        if cur then pcall(function() hum:UnequipTools() end) task.wait(0.1) end
                        pcall(function() hum:EquipTool(tool) end)
                    end
                    task.wait(0.35); continue
                end

                RevFarm.target=sortedRevenants(true)[1]
                local m=RevFarm.target
                local part=revPartFor(m)

                if not(m and part) then
                    RevFarm.stuckTimer+=SWING_INT
                    if RevFarm.stuckTimer>STUCK_THRESH and tick()-lastNotifyStuck>30 then
                        lastNotifyStuck=tick()
                        notify("No revenant found, waiting for spawn...","warn")
                        reportRevEvent("Waiting for Revenant",nil,{{name="Kills",value=tostring(RevFarm.kills)}},0x888888)
                    end
                    RevFarm.status.Text=("No revenant alive. Waiting.. (kills: %d)"):format(RevFarm.kills)
                    task.wait(0.25); continue
                end

                RevFarm.stuckTimer=0

                if hasForceField(m) then
                    pcall(stopSwing)
                    local ffRange=CONFIG.RevFarmForceFieldEscapeRange or 20
                    local distanceToRev=(part.Position-hrp.Position).Magnitude
                    if distanceToRev<=ffRange then
                        local farthest,farthestDistance=getFarthestRevFarmTeleport()
                        if farthest and farthest.pos then
                            -- Pick the configured teleport that is farthest from our
                            -- CURRENT position, then get away from the ForceField.
                            teleportTo(CFrame.new(farthest.pos))
                            RevFarm.target=nil
                            RevFarm.ffWaiting=true
                            notify(("Revenant ForceField nearby → escaped to %s"):format(esc(farthest.label or "safe point")),"warn")
                            RevFarm.status.Text=("ForceField nearby: escaped to %s"):format(esc(farthest.label or "safe point"))
                            task.wait(0.35)
                            continue
                        end
                    end

                    if not RevFarm.ffWaiting then
                        RevFarm.ffWaiting=true
                        notify("Revenant has ForceField, waiting...","warn")
                    end
                    RevFarm.status.Text=("ForceField active on %s , paused"):format(esc(m.Name))
                    task.wait(0.3); continue
                end
                RevFarm.ffWaiting=false

                local tpos=part.Position
                if tick()-lastTP>=TP_INTERVAL then
                    lastTP=tick()
                    local angle=tick()*4.7
                    local offset=Vector3.new(math.cos(angle),0,math.sin(angle))*math.max(RevFarm.dist,1.5)
                    local pos=Vector3.new(tpos.X+offset.X, tpos.Y+CONFIG.RevFarmYOffset, tpos.Z+offset.Z)
                    hrp.CFrame=CFrame.lookAt(pos,Vector3.new(tpos.X,pos.Y,tpos.Z))
                    hrp.AssemblyLinearVelocity=Vector3.zero
                    hrp.AssemblyAngularVelocity=Vector3.zero
                end

                fireSignal(tool.Activated,function() tool:Activate() end)
                task.wait(0.05)
                fireSignal(tool.Deactivated,function() tool:Deactivate() end)
                RevFarm.lastSwingAt=tick()

                local hum2=m:FindFirstChildOfClass("Humanoid")
                local hp=hum2 and math.floor(hum2.Health) or 0
                local maxHp=hum2 and math.floor(hum2.MaxHealth) or 0
                local dist=math.floor((part.Position-hrp.Position).Magnitude)
                RevFarm.status.Text=("%s → %s | HP %d/%d | %d studs | kills: %d%s"):format(
                    esc(m.Name),esc(part.Name),hp,maxHp,dist,RevFarm.kills,
                    RevFarm.ffWaiting and " [FF]" or "")

                task.wait(SWING_INT)
            end
        end)
    end -- end rev farm block

