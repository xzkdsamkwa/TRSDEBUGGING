local function setTheme(name)
    local th=THEMES[name] if not th then return end
    local map={} for _,k in ipairs(THEME_KEYS) do if T[k]~=th[k] then map[T[k]:ToHex()]=th[k] end end
    local function swap(inst,prop) local ok,c=pcall(function() return inst[prop] end) if ok and typeof(c)=="Color3" then local n=map[c:ToHex()] if n then pcall(function() inst[prop]=n end) end end end
    for _,d in ipairs(gui:GetDescendants()) do
        if not d:IsDescendantOf(espFolder) and not d:GetAttribute("NoTheme") then
            if d:IsA("GuiObject") then swap(d,"BackgroundColor3") end
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then swap(d,"TextColor3") end
            if d:IsA("TextBox") then swap(d,"PlaceholderColor3") end
            if d:IsA("UIStroke") then swap(d,"Color") end
        end
    end
    for _,k in ipairs(THEME_KEYS) do T[k]=th[k] end S.Theme=name
end

