local speedAmount, speedSlow = 0, false
local speedClone, speedUnlocked = nil, false
local speedStatus, speedModeBtn, speedSlider, speedBox

-- Speed up = negative stored value (down to -limit), slow down = positive. The UI never shows the sign.
local function desiredSpeedValue()
    if speedAmount == 0 then return 0 end
    return speedSlow and speedAmount or -speedAmount
end

local function applySpeed()
    if speedClone and speedClone.Parent then
        pcall(function()
            local want = desiredSpeedValue()
            if speedClone.Value ~= want then speedClone.Value = want end
        end)
    end
end

local function refreshSpeedUI()
    speedSlider.Label.Text = (speedSlow and "Slow down: " or "Speed up: ") .. speedAmount
    speedModeBtn.Text = speedSlow and "Mode: Slow down" or "Mode: Speed up"
end

local function lockSpeedUI(locked)
    speedUnlocked = not locked
    speedSlider:SetLocked(locked)
    speedModeBtn.BackgroundTransparency = locked and 0.5 or 0
    speedBox.TextEditable = not locked
    speedBox.BackgroundTransparency = locked and 0.5 or 0
end

local function getCurrents()
    local cd = game:GetService("ReplicatedStorage"):FindFirstChild("CharacterData")
    local mine = cd and cd:FindFirstChild(LP.Name)
    local stuff = mine and mine:FindFirstChild("PlayerStuff")
    return stuff and stuff:FindFirstChild("Currents")
end

addToggle(playerPage, "Enable Speed Helper", false, function(v)
    flags.Speed = v
    if not v then
        if speedClone then pcall(function() speedClone:Destroy() end) end
        speedClone = nil
        lockSpeedUI(true)
        speedStatus.Text = "Idle"
    else
        speedStatus.Text = "Waiting for a Speed value... equip a weapon and swing/hold it"
    end
end)

speedModeBtn = addButton(playerPage, "Mode: Speed up", function()
    if not speedUnlocked then return end
    speedSlow = not speedSlow
    refreshSpeedUI()
    applySpeed()
end)
speedSlider = addSlider(playerPage, "Speed up: 0", 0, CONFIG.SpeedLimit, 0, function(v)
    speedAmount = v
    refreshSpeedUI()
    applySpeed()
end)
speedBox = addTextbox(playerPage, "or type an amount (0-" .. CONFIG.SpeedLimit .. ")", function(t)
    local n = tonumber(t)
    speedBox.Text = ""
    if speedUnlocked and n then speedSlider:Set(math.abs(n)) end
end)
speedStatus = addLabel(playerPage, "Idle")
lockSpeedUI(true)

task.spawn(function()
    while alive do
        if flags.Speed then
            local cur = getCurrents()
            if not cur then
                speedStatus.Text = "Waiting for Currents folder..."
            else
                if speedClone and speedClone.Parent ~= cur then -- folder was rebuilt (respawn), start over
                    speedClone = nil
                    lockSpeedUI(true)
                end
                if not speedClone then
                    for _, c in ipairs(cur:GetChildren()) do
                        if c.Name ~= CONFIG.SpeedCloneName and c.Name:sub(1, 5) == "Speed" and (c:IsA("NumberValue") or c:IsA("IntValue")) then
                            local cl = c:Clone()
                            cl.Name = CONFIG.SpeedCloneName
                            cl.Value = desiredSpeedValue()
                            cl.Parent = cur
                            speedClone = cl
                            lockSpeedUI(false)
                            break
                        end
                    end
                    if not speedClone then
                        speedStatus.Text = "Waiting for a Speed value... equip a weapon and swing/hold it"
                    end
                else
                    applySpeed()
                    speedStatus.Text = ("Unlocked - %s %d"):format(speedSlow and "slow down" or "speed up", speedAmount)
                end
            end
            task.wait(0.25)
        else
            task.wait(0.3)
        end
    end
end)

----------------------------------------------------------------------
-- Player: Energy Drink (permanent)
-- Clones a REAL Energized BoolValue and keeps a copy in Currents forever
-- (also after respawn) while the toggle is on. Strips the drink's other
-- values (slowdowns, FOV) and its drifting color correction.
----------------------------------------------------------------------
addSectionHelp(playerPage, "Energy Drink", table.concat({
    "How to use:",
    "1) Drink a REAL energy drink in the game first (the game rejects a value made from nothing).",
    "2) While its effect is active, turn this toggle on.",
    "3) The script clones the Energized value and keeps it in your Currents permanently, even after respawn, as long as the toggle stays on.",
    "",
    "Also removes the drink's other values (anything named Energized / energy drink that isn't the boolean), its FOV, and its color correction.",
    "Turning it off removes the clone.",
}, "\n"))

local Drink = { template = nil, inst = nil, name = nil, spawnAt = 0, removed = 0, cc = {}, binding = false, key = nil, toggle = nil, status = nil }
local live = { cur = nil, max = nil, at = 0 }

-- live stamina from the game's own BindableEvent (status display only)
pcall(function()
    local ev = game:GetService("ReplicatedStorage"):FindFirstChild("Events")
    local b = ev and ev:FindFirstChild("StamChange")
    if b and b:IsA("BindableEvent") then
        track(b.Event:Connect(function(cur, max) live.cur, live.max, live.at = cur, max, tick() end))
    end
end)

local function isDrinkName(n)
    n = n:lower()
    return n:find("energized", 1, true) ~= nil or n:find("energy drink", 1, true) ~= nil
        or n:find("energydrink", 1, true) ~= nil or n:find("energy_drink", 1, true) ~= nil
end

local function removeDrinkClone()
    if Drink.inst then pcall(function() Drink.inst:Destroy() end) end
    Drink.inst = nil
end

-- deletes every drink-related value that is NOT the boolean (slowdowns, FOV, etc.)
local function cleanDrinkValues(cur)
    local function sweep(folder)
        if not folder then return end
        for _, c in ipairs(folder:GetChildren()) do
            if isDrinkName(c.Name) and not c:IsA("BoolValue") then
                pcall(function() c:Destroy() end)
                Drink.removed += 1
            end
        end
    end
    sweep(cur)                                              -- Currents (Speed_/SPerc_ Energized..., any FOV in there)
    sweep(cur.Parent and cur.Parent:FindFirstChild("FOVs")) -- PlayerStuff.FOVs (the drink's FOV NumberValue)
end

-- the drink's color correction: sits in the camera with the default name and its values keep changing
local function killDriftingCC()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local now, seen = tick(), {}
    for _, e in ipairs(cam:GetChildren()) do
        if e:IsA("ColorCorrectionEffect") and e.Name == "ColorCorrection" then
            seen[e] = true
            local sig = { e.Brightness, e.Contrast, e.Saturation, e.TintColor }
            local rec = Drink.cc[e]
            if not rec then
                Drink.cc[e] = { t0 = now, sig = sig, changes = 0 }
            else
                if rec.sig[1] ~= sig[1] or rec.sig[2] ~= sig[2] or rec.sig[3] ~= sig[3] or rec.sig[4] ~= sig[4] then
                    rec.changes += 1
                end
                rec.sig = sig
                -- older than 1.5s (skips the 1s damage flash) and still drifting = the drink's effect
                if now - rec.t0 > 1.5 and rec.changes >= 2 then
                    pcall(function() e:Destroy() end)
                    seen[e] = nil
                end
            end
        end
    end
    for e in pairs(Drink.cc) do
        if not seen[e] then Drink.cc[e] = nil end
    end
end

Drink.toggle = addToggle(playerPage, "Energy Drink (permanent)", false, function(v)
    flags.Drink = v
    if not v then
        removeDrinkClone() -- game then plays the drink's end effect
        if Drink.template then pcall(function() Drink.template:Destroy() end) end
        Drink.template, Drink.name, Drink.removed = nil, nil, 0
        table.clear(Drink.cc)
        if Drink.status then Drink.status.Text = "Idle" end
    end
end)
Drink.status = addLabel(playerPage, "Idle")

track(LP.CharacterAdded:Connect(function() Drink.spawnAt = tick() end))

task.spawn(function()
    while alive do
        if flags.Drink then
            local cur = getCurrents()
            local ch = LP.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")

            if not (cur and hum and hum.Health > 0) then
                Drink.status.Text = "Waiting for character / Currents folder..."
            else
                -- 1) grab a template from a REAL drink (once)
                if not Drink.template then
                    for _, c in ipairs(cur:GetChildren()) do
                        if c:IsA("BoolValue") and not c:GetAttribute("RD_Clone") and c.Name:lower():find("energized", 1, true) then
                            Drink.template = c:Clone()
                            Drink.name = c.Name
                            break
                        end
                    end
                end

                if not Drink.template then
                    Drink.status.Text = "Drink a real energy drink first, then it gets cloned automatically"
                elseif tick() - Drink.spawnAt < 2.5 then
                    Drink.status.Text = "Waiting for the game to finish loading your character..."
                else
                    -- 2) paste the clone back (also after respawn: Currents gets rebuilt)
                    if not Drink.inst or Drink.inst.Parent ~= cur then
                        local cl = Drink.template:Clone()
                        cl:SetAttribute("RD_Clone", true)
                        cl.Parent = cur
                        Drink.inst = cl
                    end
                    -- 3) strip slowdowns / FOV of the drink
                    cleanDrinkValues(cur)

                    local lines = { ("Permanent: %s (removed %d extra value(s))"):format(Drink.name, Drink.removed) }
                    if live.cur and tick() - live.at < 3 then
                        lines[#lines + 1] = ("Stamina %d / %d"):format(math.floor(tonumber(live.cur) or 0), math.floor(tonumber(live.max) or 0))
                    end
                    Drink.status.Text = table.concat(lines, "\n")
                end
            end

            -- 4) kill the drifting color correction (runs with or without the clone)
            pcall(killDriftingCC)
            task.wait(0.25)
        else
            task.wait(0.3)
        end
    end
end)

