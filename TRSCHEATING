----------------------------------------------------------------------
-- Shared state between Lottery and Scrap Farming + scrap counter
----------------------------------------------------------------------
local Shared = {
    lotteryReady = false, -- true while the lottery has at least one usable machine (it then has priority)
    farmBusy = false,     -- true while the scrap farm is mid-collection (lottery waits for it to let go)
}

-- Hook for the auto sell feature (called once when the scrap limit is reached, right after teleporting to the shop)
Shared.autoSell = function() end

local Cap = { enabled = true, max = CONFIG.ScrapMaxDefault, inst = nil, get = nil, desc = nil, nextScan = 0 }

local function isScrapName(n)
    return n:lower():find(CONFIG.ScrapCounterMatch, 1, true) ~= nil
end

-- Number value -> its value. Folder/Configuration -> amount of children (one child per scrap).
local function readCounter(inst)
    if inst:IsA("ValueBase") then
        local v = inst.Value
        return type(v) == "number" and v or nil
    end
    if inst:IsA("Folder") or inst:IsA("Configuration") then
        return #inst:GetChildren()
    end
    return nil
end

-- Searches the usual places: leaderstats, CharacterData[you].PlayerStuff (where Currents lives),
-- CharacterData[you], then the Player itself (attributes included). Returns inst, getter, description.
local function findScrapCounter()
    local cd = game:GetService("ReplicatedStorage"):FindFirstChild("CharacterData")
    local mine = cd and cd:FindFirstChild(LP.Name)
    local pg = LP:FindFirstChild("PlayerGui")
    local roots = { LP:FindFirstChild("leaderstats"), mine and mine:FindFirstChild("PlayerStuff"), mine, LP }
    for _, root in ipairs(roots) do
        if root then
            for k, v in pairs(root:GetAttributes()) do
                if isScrapName(k) and type(v) == "number" then
                    return root, function() return root:GetAttribute(k) end, root:GetFullName() .. " @" .. k
                end
            end
            for _, d in ipairs(root:GetDescendants()) do
                if isScrapName(d.Name) and readCounter(d) ~= nil and not (pg and d:IsDescendantOf(pg)) then
                    return d, function() return readCounter(d) end, d:GetFullName()
                end
            end
        end
    end
    return nil
end

local function getScrapCount()
    if not (Cap.inst and Cap.inst:IsDescendantOf(game)) then
        if tick() < Cap.nextScan then return nil end
        Cap.nextScan = tick() + 2
        Cap.inst, Cap.get, Cap.desc = findScrapCounter()
        if not Cap.inst then return nil end
    end
    local ok, v = pcall(Cap.get)
    return ok and tonumber(v) or nil
end

