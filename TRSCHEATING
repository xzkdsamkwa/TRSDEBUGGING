local webhookUrl = ""
local httpRequest = ENV.request or ENV.http_request or (ENV.syn and ENV.syn.request) or (ENV.http and ENV.http.request)

local function sendWebhook(title, fields, color, force)
    if not force and not flags.Webhook then return end
    if webhookUrl == "" then warn("[RevenantDebug] Webhook URL is empty.") return end
    local body = HttpService:JSONEncode({
        username = "Revenant Debug",
        embeds = {{ title = title, color = color or 0xCD323C, fields = fields or {}, timestamp = DateTime.now():ToIsoDate() }},
    })
    if httpRequest then
        local ok, err = pcall(httpRequest, { Url = webhookUrl, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
        if not ok then warn("[RevenantDebug] Webhook failed: " .. tostring(err)) end
    else
        local ok, err = pcall(function() return HttpService:PostAsync(webhookUrl, body) end)
