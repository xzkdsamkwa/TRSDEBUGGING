local notifCounter = 0
local activeNotifs = {}

local function notify(message, kind)
    if S.NotifOff then return end
    local style = NOTIF[kind] or NOTIF.neutral
    notifCounter += 1

    local stroke = new("UIStroke", { Color = style.c1, Thickness = 1.2, Transparency = 1 })
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
        LayoutOrder = notifCounter,
        ZIndex = 500, Parent = notifLayer,
    }, {
        corner(6),
        new("UIGradient", { Color = ColorSequence.new(style.c1, style.c2), Rotation = 0 }),
        stroke,
        new("UIPadding", {
            PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
        }),
    })

    local bar = new("Frame", {
        Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = style.bar, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 501, Parent = frame,
    }, { corner(3) })

    local lbl = new("TextLabel", {
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -14, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Text = style.icon .. "  " .. message, TextColor3 = Color3.new(1, 1, 1),
        TextTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 12, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 501, Parent = frame,
    })
    lbl:SetAttribute("NoTheme", true)
    bar:SetAttribute("NoTheme", true)
    frame:SetAttribute("NoTheme", true)

    local hitbox = new("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 502, Parent = frame,
    })

    local ti = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(frame, ti, { BackgroundTransparency = 0.05 }):Play()
    TweenService:Create(stroke, ti, { Transparency = 0.35 }):Play()
    TweenService:Create(bar, ti, { BackgroundTransparency = 0 }):Play()
    TweenService:Create(lbl, ti, { TextTransparency = 0 }):Play()

    local dismissed = false
    local dismiss
    dismiss = function()
        if dismissed then return end
        dismissed = true
        local i = table.find(activeNotifs, dismiss)
        if i then table.remove(activeNotifs, i) end
        local to = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tw = TweenService:Create(frame, to, { BackgroundTransparency = 1 })
        TweenService:Create(stroke, to, { Transparency = 1 }):Play()
        TweenService:Create(bar, to, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(lbl, to, { TextTransparency = 1 }):Play()
        tw.Completed:Connect(function() pcall(function() frame:Destroy() end) end)
        tw:Play()
    end

    track(hitbox.Activated:Connect(dismiss))
    activeNotifs[#activeNotifs + 1] = dismiss
    while #activeNotifs > 6 do activeNotifs[1]() end
    task.delay(S.NotifDuration, dismiss)
end

