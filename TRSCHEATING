local reportRevDeath, dropRevenant, reportRevEvent, clearRev, considerHumanoid, rescanRevenants, sortedRevenants

do
    local function _reportRevEvent(title, m, extraFields, color)
        if not flags.WebhookRev then return end
        local part = partOf(m)
        local pos = part and part.Position or Vector3.zero
        local fields = {
            { name = "Revenant", value = tostring(m and m.Name or "Unknown"), inline = true },
            { name = "Kill #", value = tostring(RevFarm.kills), inline = true },
            { name = "Position", value = ("%d, %d, %d"):format(pos.X, pos.Y, pos.Z), inline = true },
            { name = "Server", value = game.JobId ~= "" and game.JobId:sub(1, 20) or "Studio", inline = true },
        }
        for _, f in ipairs(extraFields or {}) do fields[#fields + 1] = f end
        task.spawn(sendWebhook, title, fields, color or 0xCD323C)
    end
    reportRevEvent = _reportRevEvent

    local function _reportRevDeath(m)
        if revDeathSent[m] then return end
        revDeathSent[m] = true
        RevFarm.kills += 1
        notify(("Revenant killed (#%d)"):format(RevFarm.kills), "farm")
        _reportRevEvent("Revenant Killed", m, {
            { name = "Farming", value = flags.RevFarm and ("ON — Tool: " .. tostring(RevFarm.tool)) or "OFF", inline = true },
            { name = "Session Kills", value = tostring(RevFarm.kills) },
        }, 0xCD323C)
    end
    reportRevDeath = _reportRevDeath

    local function _clearRev(m)
        local e = revESP[m]
        if e then
            if e.bb then e.bb:Destroy() end
            if e.hl then e.hl:Destroy() end
            revESP[m] = nil
        end
    end
    clearRev = _clearRev

    local function _dropRevenant(m)
        local h = revHum[m]
        if h and h.Health <= 0 then _reportRevDeath(m) end
        revenants[m] = nil
        revHum[m] = nil
        local c = revDiedConn[m]
        if c then c:Disconnect() revDiedConn[m] = nil end
        _clearRev(m)
    end
    dropRevenant = _dropRevenant

    local function _considerHumanoid(h)
        task.defer(function()
            local m = h.Parent
            if m and not revenants[m] and isRevenant(m) then
                revenants[m] = true
                revHum[m] = h
                revDiedConn[m] = h.Died:Connect(function() _reportRevDeath(m) end)
            end
        end)
    end
    considerHumanoid = _considerHumanoid

    local function _rescanRevenants()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then _considerHumanoid(d) end
        end
    end
    rescanRevenants = _rescanRevenants

    local function _sortedRevenants(aliveOnly)
        local arr = {}
        for m in pairs(revenants) do
            if m:IsDescendantOf(workspace) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                if not aliveOnly or (hum and hum.Health > 0) then arr[#arr + 1] = m end
            end
        end
        local hrp = getHRP()
        if hrp then
            table.sort(arr, function(a, b)
                local pa, pb = partOf(a), partOf(b)
                if not pa or not pb then return pa ~= nil end
                return (pa.Position - hrp.Position).Magnitude < (pb.Position - hrp.Position).Magnitude
            end)
        end
        return arr
    end
    sortedRevenants = _sortedRevenants
end

