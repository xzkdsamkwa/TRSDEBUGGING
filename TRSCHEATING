-- swings constantly. Every revenant death is sent to the Discord webhook
-- (Misc > Settings).
----------------------------------------------------------------------
do
    local function normName(s) return (tostring(s):lower():gsub("[^%w]", "")) end

    -- the part we aim at
    local function revPartFor(m)
        if not m then return nil end
        if RevFarm.head then
            return m:FindFirstChild("Head") or m:FindFirstChild("Head", true) or m:FindFirstChild("HumanoidRootPart") or partOf(m)
        end
        if RevFarm.body == "HumanoidRootPart" then
            return m:FindFirstChild("HumanoidRootPart") or partOf(m)
        end
        return m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso", true)
            or m:FindFirstChild("HumanoidRootPart") or partOf(m)
    end

    -- exact (normalized) name match in hand or backpack; custom names also accept a partial match
    local function findFarmTool()
        local want = normName(RevFarm.tool)
        if want == "" then return nil end
        local partial
        for _, container in ipairs({ LP.Character, LP:FindFirstChildOfClass("Backpack") }) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") then
                        local n = normName(t.Name)
                        if n == want then return t end
                        if not partial and RevFarm.custom[want] and n:find(want, 1, true) then partial = t end
                    end
                end
            end
        end
        return partial
    end

    local function stopSwing()
        local ch = LP.Character
        local tool = ch and ch:FindFirstChildOfClass("Tool")
        if tool then fireSignal(tool.Deactivated, function() tool:Deactivate() end) end
    end

