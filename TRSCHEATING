local function findPowerStation()
    return workspace:FindFirstChild(CONFIG.PowerStationName, true)
end

local function findPowerStationCore()
    local ps = findPowerStation()
    if not ps then return nil end
    for _, n in ipairs(CONFIG.PowerStationCoreNames) do
        local f = ps:FindFirstChild(n, true)
        if f then return f end
    end
    for _, d in ipairs(ps:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("core", 1, true) then return d end
    end
    return nil
end

local function powerStationPrompts()
    local out = {}
    local ps = findPowerStation()
    if ps then
        for _, d in ipairs(ps:GetDescendants()) do
            if d:IsA("ProximityPrompt") then out[#out + 1] = d end
        end
    end
    return out, ps
end

