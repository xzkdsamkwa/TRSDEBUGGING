-- Fires the equipped tool's own Activated/Deactivated connections, exactly like a click.
-- Deactivated fires ~0.05s later, so Mouse1Down is never held long enough to start a charged attack.
local function fireSignal(signal, fallback)
    local fired = false
    if ENV.getconnections then
        local ok, list = pcall(ENV.getconnections, signal)
        if ok and type(list) == "table" then
            for _, c in ipairs(list) do
                if pcall(function() c:Fire() end) then fired = true end
            end
        end
    end
    if not fired then pcall(fallback) end
end

