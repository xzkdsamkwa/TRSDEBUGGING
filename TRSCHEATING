                else
                    local e = revESP[m]
                    if not e then e = {} revESP[m] = e end
                    local part = partOf(m)

                    if flags.Track and part then
                        if not e.bb then
                            e.bb = new("BillboardGui", {
                                Name = "RevenantTrack", AlwaysOnTop = true, Size = UDim2.fromOffset(140, 36),
                                StudsOffset = Vector3.new(0, 3, 0), MaxDistance = math.huge, ResetOnSpawn = false, Parent = espFolder,
                            })
                            e.lbl = new("TextLabel", {
                                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 30, 30),
                                TextStrokeTransparency = 0, Font = Enum.Font.GothamBold, TextSize = 14, Parent = e.bb,
                            })
                        end
                        e.bb.Adornee = part
                        local dist = hrp and math.floor((part.Position - hrp.Position).Magnitude) or 0
                        e.lbl.Text = ("REVENANT\n%d studs"):format(dist)
                    elseif e.bb then
                        e.bb:Destroy() e.bb, e.lbl = nil, nil
                    end

                    if flags.Highlight then
                        if not e.hl then
                            e.hl = new("Highlight", {
                                Name = "RevenantHL", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                                FillColor = Color3.fromRGB(255, 30, 30), FillTransparency = 0.6,
                                OutlineColor = Color3.fromRGB(255, 255, 255), Parent = espFolder,
                            })
                        end
                        e.hl.Adornee = m
                    elseif e.hl then
                        e.hl:Destroy() e.hl = nil
                    end
                end
            end

            local arr = sortedRevenants()
            if selectedModel and not selectedModel:IsDescendantOf(workspace) then selectedModel, cycleIdx = nil, 0 end
            local target = selectedModel or arr[1]
            if target then
                local idx = table.find(arr, target) or 1
                targetBtn.Text = ("Target: %s (%d/%d)%s - click to cycle"):format(target.Name, idx, #arr, selectedModel and "" or " [nearest]")
                modelAttrLabel.Text = attrText(target)
                local hum = target:FindFirstChildOfClass("Humanoid")
                humAttrLabel.Text = hum and attrText(hum) or '<font color="#888888">(no humanoid)</font>'
            else
                targetBtn.Text = "Target: none found"
                modelAttrLabel.Text = '<font color="#888888">No revenant found</font>'
                humAttrLabel.Text = '<font color="#888888">No revenant found</font>'
            end

            tick5 += 0.25
            if tick5 >= 5 then tick5 = 0 rescanRevenants() end
            task.wait(0.25)
        end
    end)
end -- end NPC UI block

----------------------------------------------------------------------
-- FARMING PAGE
----------------------------------------------------------------------
local farmPage = addTab("Farming", false)
local farmSubs = addSubTabs(farmPage, { "Scrap Farming", "Auto Farm Revenant" }, 140)
local scrapPage = farmSubs["Scrap Farming"]
local revPage   = farmSubs["Auto Farm Revenant"]

-- scrap farming helpers declared at outer scope so farming loop can reach them
local restorePromptHolds, getGolden, spamPrompt

do -- scrap farming block
    local scrapColors = { Golden = Color3.fromRGB(248, 186, 0), Cursed = Color3.fromRGB(255, 0, 0) }
    local scrapCooldown = {}
    local scrapESP = {}
    local promptHoldOverrides = {}
    local promptCache = setmetatable({}, { __mode = "k" })
    local spamDelayMs = 40

    local function _restorePromptHolds()
        for p, orig in pairs(promptHoldOverrides) do
            if p and p.Parent then pcall(function() p.HoldDuration = orig end) end
        end
        table.clear(promptHoldOverrides)
    end
    restorePromptHolds = _restorePromptHolds

    local function zeroPromptHold(prompt)
        if not prompt or not prompt.Parent then return end
        if promptHoldOverrides[prompt] == nil then promptHoldOverrides[prompt] = prompt.HoldDuration end
        if prompt.HoldDuration ~= CONFIG.ScrapHoldOverride then
            pcall(function() prompt.HoldDuration = CONFIG.ScrapHoldOverride end)
        end
    end

    local function scrapTypeOf(inst)
        local t = inst:GetAttribute(CONFIG.ScrapAttribute)
        if type(t) ~= "string" then return nil end
        for _, name in ipairs(CONFIG.ScrapTypes) do
            if t:lower() == name:lower() then return name end
        end
        return nil
    end

    local function scrapsRoot()
        local map = workspace:FindFirstChild("MAP")
        return (map and map:FindFirstChild("Scraps")) or workspace
    end

    local function scrapPromptFor(inst, root)
        local own = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        if own then return own end
        local myType = scrapTypeOf(inst)
        local cur = inst.Parent
        for _ = 1, 4 do
            if not cur or cur == workspace or cur == root then break end
            local mixed = false
            for _, d in ipairs(cur:GetDescendants()) do
                if d ~= inst and d:IsA("BasePart") then
                    local t = scrapTypeOf(d)
                    if t and t ~= myType then mixed = true break end
                end
            end
            if mixed then break end
            local pp = cur:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp then return pp end
            cur = cur.Parent
        end
        return nil
    end

    local function promptFor(inst, root)
        local c = promptCache[inst]
        if c and c.Parent then return c end
        local p = scrapPromptFor(inst, root)
        promptCache[inst] = p
        return p
    end

    local function looksGolden(c)
        if typeof(c) ~= "Color3" then return false end
        local h, s, v = c:ToHSV()
        return h >= 0.09 and h <= 0.17 and s >= 0.55 and v >= 0.5
    end

    local function partIsGolden(part)
        if looksGolden(part.Color) then return true end
        for _, d in ipairs(part:GetDescendants()) do
            if d:IsA("BasePart") then
                if looksGolden(d.Color) then return true end
            elseif d:IsA("Highlight") then
                if looksGolden(d.FillColor) or looksGolden(d.OutlineColor) then return true end
            elseif d:IsA("Light") then
                if looksGolden(d.Color) then return true end
            end
        end
        return false
    end

    local function scanScraps(goldenOnly)
        local root = scrapsRoot()
        local out, seenPrompt, rejected = {}, {}, 0
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("BasePart") then
                local t = scrapTypeOf(d)
                if t then
                    if not goldenOnly then
                        out[#out + 1] = { inst = d, type = t }
                    elseif t == "Golden" then
                        if flags.StrictGold ~= false and not partIsGolden(d) then
                            rejected += 1
                        else
                            local prompt = promptFor(d, root)
                            if prompt and not seenPrompt[prompt] then
                                seenPrompt[prompt] = true
                                out[#out + 1] = { inst = d, type = t, prompt = prompt }
                            end
                        end
                    end
                end
            end
        end
        return out, rejected
    end

    local goldCache = { t = 0, list = {}, rejected = 0 }
    local function _getGolden(force)
        if force or tick() - goldCache.t > 0.3 then
            goldCache.list, goldCache.rejected = scanScraps(true)
            goldCache.t = tick()
        end
        return goldCache.list
    end
    getGolden = _getGolden

    local function scrapAvailable(inst, prompt)
        if not inst:IsDescendantOf(workspace) then return false end
        return promptAvailable(prompt or promptFor(inst, scrapsRoot()))
    end

    local function _spamPrompt(prompt, inst, cf, maxTime)
        local t0 = tick()
        while flags.Farm and tick() - t0 < maxTime do
            if not scrapAvailable(inst, prompt) then return true end
            local h = getHRP()
            if h and (h.Position - cf.Position).Magnitude > 6 then teleportTo(cf) end
            zeroPromptHold(prompt)
            pcall(firePrompt, prompt)
            task.wait(spamDelayMs / 1000)
        end
        return not scrapAvailable(inst, prompt)
    end
    spamPrompt = _spamPrompt

    addSection(scrapPage, "Scrap Farming (Golden only — spams pickup)")
    local farmStatus, scrapStats
    local farmCollected = 0
    addToggle(scrapPage, "Scrap Farming", false, function(v)
        flags.Farm = v
        if not v then
            releaseCamera()
            _restorePromptHolds()
            if farmStatus then farmStatus.Text = "Idle" end
        end
    end)
    addToggle(scrapPage, "Strict golden color check", true, function(v)
        flags.StrictGold = v
        goldCache.t = 0
    end)
    local spamSlider
    spamSlider = addSlider(scrapPage, "Prompt spam delay", 10, 150, spamDelayMs, function(v)
        spamDelayMs = v
        spamSlider.Label.Text = ("Prompt spam delay: %d ms"):format(v)
    end, { save = "Prompt spam delay" })
    spamSlider.Label.Text = ("Prompt spam delay: %d ms"):format(spamDelayMs)

    addSection(scrapPage, "ESP")
    addToggle(scrapPage, "Scrap ESP (Golden / Cursed)", false, function(v) flags.ScrapESP = v end)
    addSection(scrapPage, "Status")
    farmStatus = addLabel(scrapPage, "Idle")
    scrapStats = addLabel(scrapPage, "Golden found: -")

    task.spawn(function()
        while alive do
            if flags.Farm then
                local hrp = getHRP()
                if not hrp then
                    farmStatus.Text = "Waiting for character..."
                    task.wait(0.5)
                else
                    local best, bestDist
                    local list = _getGolden()
                    for _, s in ipairs(list) do
                        if (scrapCooldown[s.inst] or 0) < tick() and scrapAvailable(s.inst, s.prompt) then
                            local p = partOf(s.inst)
                            if p then
                                local d = (p.Position - hrp.Position).Magnitude
                                if not bestDist or d < bestDist then best, bestDist = s, d end
                            end
                        end
                    end
                    scrapStats.Text = ("Golden found: %d | skipped (not gold): %d | collected: %d"):format(#list, goldCache.rejected, farmCollected)

                    if best then
                        local inst, prompt = best.inst, best.prompt
                        local cf = promptCFrame(prompt, inst)
                        if cf then
                            local scrapPart = partOf(inst)
                            local lookAt = scrapPart and scrapPart.Position or cf.Position

                            farmStatus.Text = "Collecting Golden (spamming prompt)..."
                            teleportTo(cf)
                            task.wait(0.1)
                            aimCamera(lookAt)

                            local picked = _spamPrompt(prompt, inst, cf, 3)
                            releaseCamera()
                            goldCache.t = 0

                            if picked then
                                farmCollected += 1
                                farmStatus.Text = "Collected Golden — waiting for respawn..."
                                notify(("Golden scrap collected (#%d)"):format(farmCollected), "farm")
                                local pos = cf.Position
                                sendWebhook("Scrap collected: Golden", {
                                    { name = "Type", value = "Golden", inline = true },
                                    { name = "Position", value = ("%d, %d, %d"):format(pos.X, pos.Y, pos.Z) },
                                    { name = "Server", value = game.JobId ~= "" and game.JobId:sub(1, 20) or "Studio" },
                                }, 0xFFC828)
                            else
                                scrapCooldown[inst] = tick() + CONFIG.ScrapRetryCooldown
                                farmStatus.Text = "Pickup timed out, cooling down..."
                            end
                        else
                            scrapCooldown[inst] = tick() + CONFIG.ScrapRetryCooldown
                        end
                    else
                        farmStatus.Text = "No golden scrap available, waiting for respawn..."
                        task.wait(0.4)
                    end
                    task.wait(0.03)
                end
            else
                task.wait(0.3)
            end
        end
    end)

    task.spawn(function()
        while alive do
            if flags.ScrapESP then
                local seen = {}
                local hrp = getHRP()
                for _, s in ipairs(scanScraps(false)) do
                    local part = partOf(s.inst)
                    if part then
                        seen[s.inst] = true
                        local e = scrapESP[s.inst]
                        if not e then
                            local bb = new("BillboardGui", {
                                Name = "ScrapESP", AlwaysOnTop = true, Size = UDim2.fromOffset(120, 30),
                                StudsOffset = Vector3.new(0, 2, 0), MaxDistance = math.huge, ResetOnSpawn = false, Parent = espFolder,
                            })
                            local lbl = new("TextLabel", {
                                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, TextColor3 = scrapColors[s.type] or Color3.new(1, 1, 1),
                                TextStrokeTransparency = 0, Font = Enum.Font.GothamBold, TextSize = 13, Parent = bb,
                            })
                            e = { bb = bb, lbl = lbl }
                            scrapESP[s.inst] = e
                        end
                        e.bb.Adornee = part
                        local dist = hrp and math.floor((part.Position - hrp.Position).Magnitude) or 0
                        e.lbl.Text = ("%s\n%d studs"):format(s.type, dist)
                    end
                end
                for inst, e in pairs(scrapESP) do
                    if not seen[inst] then e.bb:Destroy() scrapESP[inst] = nil end
                end
            else
                for inst, e in pairs(scrapESP) do e.bb:Destroy() scrapESP[inst] = nil end
            end
            task.wait(1)
        end
    end)
end -- end scrap farming block

----------------------------------------------------------------------
-- AUTO FARM REVENANT
----------------------------------------------------------------------
do
    local function normName(s) return (tostring(s):lower():gsub("[^%w]", "")) end
    local function revPartFor(m)
        if not m then return nil end
        if RevFarm.head then
            return m:FindFirstChild("Head") or m:FindFirstChild("Head", true) or m:FindFirstChild("HumanoidRootPart") or partOf(m)
        end
        if RevFarm.body == "HumanoidRootPart" then
            return m:FindFirstChild("HumanoidRootPart") or partOf(m)
        end
        return m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso", true)
            or m:FindFirstChild("HumanoidRootPart") or partOf(m)
    end

    local function findFarmTool()
        local want = normName(RevFarm.tool)
        if want == "" then return nil end
        local partial
        for _, container in ipairs({ LP.Character, LP:FindFirstChildOfClass("Backpack") }) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") then
                        local n = normName(t.Name)
                        if n == want then return t end
                        if not partial and RevFarm.custom[want] and n:find(want, 1, true) then partial = t end
                    end
                end
            end
        end
        return partial
    end

    local function stopSwing()
        local ch = LP.Character
        local tool = ch and ch:FindFirstChildOfClass("Tool")
        if tool then fireSignal(tool.Deactivated, function() tool:Deactivate() end) end
    end

    local function stopAnimations()
        local ch = LP.Character
        if not ch then return end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if ok and tracks then
                for _, tr in ipairs(tracks) do pcall(function() tr:Stop(0) end) end
            end
        end
    end

    local function releaseRevCamera()
        if RevFarm.camHeld then RevFarm.camHeld = false releaseCamera() end
    end

    addSection(revPage, "Auto Farm Revenant")
    RevFarm.toggle = addToggle(revPage, "Auto Farm Revenant", false, function(v)
        flags.RevFarm = v
        if not v then
            RevFarm.target = nil
            RevFarm.stuckTimer = 0
            releaseRevCamera()
            pcall(stopSwing)
            if RevFarm.status then RevFarm.status.Text = "Idle" end
            reportRevEvent("Farm Stopped", nil, {{ name = "Session Kills", value = tostring(RevFarm.kills) }}, 0x888888)
        else
            RevFarm.kills = 0
            notify("Auto Farm Revenant started — tool: " .. esc(RevFarm.tool), "farm")
            reportRevEvent("Farm Started", nil, {{ name = "Tool", value = RevFarm.tool, inline = true }}, 0x46C86E)
        end
    end)
    RevFarm.status = addLabel(revPage, "Idle")

    addSectionHelp(revPage, "Weapon", table.concat({
        "Pick the weapon to farm with. It is equipped automatically from your hand or backpack.",
        "",
        "Recommended: LAZARUS, Dragon Slayer, Azure Endbringer.",
        "",
        "Not in the list? Type the exact tool name in the box below the list and press Enter.",
    }, "\n"))

    local toolHolder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        LayoutOrder = nextLO(), Parent = revPage,
    }, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local function selectTool(name)
        RevFarm.tool = name
        local n = normName(name)
        for _, r in ipairs(RevFarm.rows) do
            r.btn.BackgroundColor3 = (r.norm == n) and T.accent or T.row
        end
    end

    local function addToolRow(name, rec, custom)
        local n = normName(name)
        for _, r in ipairs(RevFarm.rows) do if r.norm == n then return r end end
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = T.row, Text = "", AutoButtonColor = false,
            LayoutOrder = #RevFarm.rows + 1, Parent = toolHolder,
        }, { corner(6) })
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0), Text = name,
            TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
        })
        if rec then
            local tag = new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(96, 16),
                BackgroundColor3 = T.on, Text = "RECOMMENDED", TextColor3 = Color3.new(1, 1, 1),
                Font = Enum.Font.GothamBold, TextSize = 10, Parent = btn,
            }, { corner(4) })
            tag:SetAttribute("NoTheme", true)
        elseif custom then
            new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(60, 16),
                BackgroundColor3 = T.off, Text = "CUSTOM", TextColor3 = T.text,
                Font = Enum.Font.GothamBold, TextSize = 10, Parent = btn,
            }, { corner(4) })
        end
        local row = { name = name, norm = n, btn = btn }
        RevFarm.rows[#RevFarm.rows + 1] = row
        if custom then RevFarm.custom[n] = true RevFarm.customList[#RevFarm.customList + 1] = name end
        track(btn.Activated:Connect(function() selectTool(name) end))
        return row
    end
    RevFarm.addToolRow, RevFarm.selectTool = addToolRow, selectTool

    for _, t in ipairs(CONFIG.RevenantTools) do addToolRow(t.name, t.rec, false) end
    selectTool(RevFarm.tool)

    local customBox
    customBox = addTextbox(revPage, "Custom tool name (Enter to add)", function(t)
        local name = t:match("^%s*(.-)%s*$")
        customBox.Text = ""
        if not name or name == "" then return end
        addToolRow(name, false, true)
        selectTool(name)
        notify("Custom tool added: " .. esc(name), "info")
    end)

    addSection(revPage, "Aim")
    addToggle(revPage, "Aim at head (headshot multiplier)", true, function(v) RevFarm.head = v end)
    local bodyBtn
    RevFarm.setBody = function(b)
        if b ~= "Torso" and b ~= "HumanoidRootPart" then return end
        RevFarm.body = b
        bodyBtn.Text = ("Body target (head aim off): %s"):format(b)
    end
    bodyBtn = addButton(revPage, "Body target (head aim off): Torso", function()
        RevFarm.setBody(RevFarm.body == "Torso" and "HumanoidRootPart" or "Torso")
        notify("Body target: " .. RevFarm.body, "info")
    end)
    addToggle(revPage, "Face target + lock camera", true, function(v)
        RevFarm.camAim = v
        if not v then releaseRevCamera() end
    end)
    local distSlider
    distSlider = addSlider(revPage, "Distance", 3, 20, RevFarm.dist, function(v)
        RevFarm.dist = v
        distSlider.Label.Text = ("Distance: %d studs"):format(v)
    end, { save = "Revenant farm distance" })
    distSlider.Label.Text = ("Distance: %d studs"):format(RevFarm.dist)

    addSection(revPage, "Kill Count")
    addButton(revPage, "Reset kill counter", function()
        RevFarm.kills = 0
        notify("Kill counter reset", "neutral")
    end)

    track(RunService.Heartbeat:Connect(function()
        if not flags.RevFarm then return end
        local hrp = getHRP()
        local m = RevFarm.target
        if not hrp or not m or not m:IsDescendantOf(workspace) then return end
        local part = revPartFor(m)
        if not part then return end
        local tpos = part.Position
        local flat = Vector3.new(hrp.Position.X - tpos.X, 0, hrp.Position.Z - tpos.Z)
        if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, 1) end
        local p = tpos + flat.Unit * RevFarm.dist
        local pos = Vector3.new(p.X, tpos.Y + CONFIG.RevFarmYOffset, p.Z)
        hrp.CFrame = CFrame.lookAt(pos, Vector3.new(tpos.X, pos.Y, tpos.Z))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end))

    local function camStep()
        if not flags.RevFarm or not RevFarm.camAim then return end
        local cam = workspace.CurrentCamera
        local hrp = getHRP()
        local m = RevFarm.target
        local part = m and m:IsDescendantOf(workspace) and revPartFor(m)
        if not (cam and hrp and part) then releaseRevCamera() return end
        RevFarm.camHeld = true
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.lookAt(hrp.Position + Vector3.new(0, 1.5, 0), part.Position)
    end
    pcall(function() RunService:UnbindFromRenderStep("RevFarmCam") end)
    RunService:BindToRenderStep("RevFarmCam", Enum.RenderPriority.Camera.Value + 10, camStep)

    task.spawn(function()
        local SWING_INTERVAL    = CONFIG.AutoAttackInterval
        local EQUIP_RETRY_DELAY = 1.5
        local STUCK_THRESHOLD   = 8
        local lastNotifyStuck   = 0

        while alive do
            if not flags.RevFarm then
                task.wait(0.3)
            else
                local ch = LP.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local hrp = getHRP()

                if not (hum and hrp and hum.Health > 0) then
                    RevFarm.status.Text = "Waiting for character to respawn..."
                    RevFarm.target = nil
                    task.wait(0.5)
                else
                    local tool = findFarmTool()
                    if not tool then
                        RevFarm.status.Text = ('<font color="#ff5a5a">Tool "%s" not found in hand/backpack</font>'):format(esc(RevFarm.tool))
                        task.wait(EQUIP_RETRY_DELAY)
                    elseif tool.Parent ~= ch then
                        RevFarm.status.Text = "Equipping " .. esc(tool.Name)
                        local ok = pcall(function() hum:EquipTool(tool) end)
                        if not ok then
                            local current = ch:FindFirstChildOfClass("Tool")
                            if current then pcall(function() hum:UnequipTools() end) task.wait(0.1) end
                            pcall(function() hum:EquipTool(tool) end)
                        end
                        task.wait(0.35)
                    else
                        RevFarm.target = sortedRevenants(true)[1]
                        local m = RevFarm.target
                        local part = revPartFor(m)

                        if not (m and part) then
                            RevFarm.stuckTimer += SWING_INTERVAL
                            if RevFarm.stuckTimer > STUCK_THRESHOLD then
                                if tick() - lastNotifyStuck > 30 then
                                    lastNotifyStuck = tick()
                                    notify("No revenant found — waiting for spawn...", "warn")
                                    reportRevEvent("Waiting for Revenant Spawn", nil, {
                                        { name = "Session Kills", value = tostring(RevFarm.kills) },
                                    }, 0x888888)
                                end
                            end
                            RevFarm.status.Text = ("No revenant alive — waiting for spawn... (kills: %d)"):format(RevFarm.kills)
                            task.wait(0.25)
                        else
                            RevFarm.stuckTimer = 0
                            local dist = (part.Position - hrp.Position).Magnitude
                            if dist <= RevFarm.dist + 8 then
                                fireSignal(tool.Activated, function() tool:Activate() end)
                                task.wait(0.05)
                                fireSignal(tool.Deactivated, function() tool:Deactivate() end)
                                RevFarm.lastSwingAt = tick()
                                stopAnimations()
                            end
                            local hum2 = m:FindFirstChildOfClass("Humanoid")
                            local hp = hum2 and math.floor(hum2.Health) or 0
                            local maxHp = hum2 and math.floor(hum2.MaxHealth) or 0
                            RevFarm.status.Text = ("%s → %s | HP %d/%d | %d studs\nTool: %s | kills: %d"):format(
                                esc(m.Name), esc(part.Name), hp, maxHp, math.floor(dist), esc(tool.Name), RevFarm.kills)
                            task.wait(SWING_INTERVAL)
                        end
