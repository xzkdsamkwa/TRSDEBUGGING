    local holder = new("Frame", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32), BackgroundTransparency = 1, Parent = page })
    local subs, btns = {}, {}
    local function pick(n)
        for k, s in pairs(subs) do s.Visible = (k == n) end
        for k, b in pairs(btns) do b.BackgroundColor3 = (k == n) and T.accent or T.row end
    end
    for _, n in ipairs(names) do
        btns[n] = new("TextButton", {
            Size = UDim2.fromOffset(btnWidth or 84, 24), BackgroundColor3 = T.row, Text = n, TextColor3 = T.text,
            Font = Enum.Font.GothamMedium, TextSize = 12, Parent = bar,
        }, { corner(5) })
        subs[n] = newList(holder)
        subs[n].Visible = false
        track(btns[n].Activated:Connect(function() pick(n) end))
    end
    pick(names[1])
    return subs
end

