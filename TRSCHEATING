local function scrapTypeOf(inst)
    local t = inst:GetAttribute(CONFIG.ScrapAttribute)
    if type(t) ~= "string" then return nil end
    for _, name in ipairs(CONFIG.ScrapTypes) do
        if t:lower() == name:lower() then return name end
    end
    return nil
end

local function scrapsRoot()
    local map = workspace:FindFirstChild("MAP")
    return (map and map:FindFirstChild("Scraps")) or workspace
end

local function scanScraps()
    local root = scrapsRoot()
    local out, seenPrompt = {}, {}
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then
            local t = scrapTypeOf(d)
            if t then
                -- several MeshParts of one scrap share a prompt: count the scrap once
                local prompt = findPrompt(d, root)
                if not prompt or not seenPrompt[prompt] then
                    if prompt then seenPrompt[prompt] = true end
                    out[#out + 1] = { inst = d, type = t, prompt = prompt }
                end
            end
        end
    end
    return out
end

local function scrapAvailable(inst)
    if not inst:IsDescendantOf(workspace) then return false end
    return promptAvailable(findPrompt(inst, scrapsRoot()))
end

