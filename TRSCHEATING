local injectedCurrents = {}

local function injectCurrent(name)
    if injectedCurrents[name] and injectedCurrents[name].Parent then return injectedCurrents[name] end
    local cur = getCurrentsFolder()
    if not cur then return nil end
    local template
    for _, v in ipairs(cur:GetChildren()) do
        if v:IsA("BoolValue") then template = v break end
    end
    if not template then
        template = Instance.new("BoolValue")
        template.Name = "__rdtmp"
        template.Value = true
        template.Parent = cur
    end
    local cl = template:Clone()
    if cl.Name == "__rdtmp" then template:Destroy() end
    cl.Name = name
    cl.Value = true
    cl.Parent = cur
    injectedCurrents[name] = cl
    return cl
end

local function removeCurrent(name)
    local inst = injectedCurrents[name]
    if inst and inst.Parent then
        pcall(function() inst:Destroy() end)
    end
    injectedCurrents[name] = nil
    local cur = getCurrentsFolder()
    if cur then
        for _, v in ipairs(cur:GetChildren()) do
            if v.Name == name then pcall(function() v:Destroy() end) end
        end
    end
end

local injectedNumCurrents = {}
local function injectNumCurrent(name, value, folder)
    local cur = folder or getCurrentsFolder()
    if not cur then return nil end
    if injectedNumCurrents[name] and injectedNumCurrents[name].Parent then
        injectedNumCurrents[name].Value = value
        return injectedNumCurrents[name]
    end
    local template
    for _, v in ipairs(cur:GetChildren()) do
        if v:IsA("NumberValue") then template = v break end
    end
    if not template then
        template = Instance.new("NumberValue")
        template.Name = "__rdntmp"
        template.Parent = cur
    end
    local cl = template:Clone()
    if cl.Name == "__rdntmp" then template:Destroy() end
    cl.Name = name
    cl.Value = value
    cl.Parent = cur
    injectedNumCurrents[name] = cl
    return cl
end

local function removeNumCurrent(name)
    local inst = injectedNumCurrents[name]
    if inst and inst.Parent then pcall(function() inst:Destroy() end) end
    injectedNumCurrents[name] = nil
    local cur = getCurrentsFolder()
    if cur then
        for _, v in ipairs(cur:GetChildren()) do
            if v.Name == name then pcall(function() v:Destroy() end) end
        end
    end
end

local currentKeepalive = {}
local numCurrentKeepalive = {}
track(RunService.Heartbeat:Connect(function()
    for name in pairs(currentKeepalive) do
        if not (injectedCurrents[name] and injectedCurrents[name].Parent) then
            injectCurrent(name)
        end
    end
    for name, val in pairs(numCurrentKeepalive) do
        if not (injectedNumCurrents[name] and injectedNumCurrents[name].Parent) then
            injectNumCurrent(name, val)
        end
    end
end))

local function manageCurrent(name, enabled)
    if enabled then
        currentKeepalive[name] = true
        injectCurrent(name)
    else
        currentKeepalive[name] = nil
        removeCurrent(name)
    end
end

local function manageNumCurrent(name, value, enabled)
    if enabled then
        numCurrentKeepalive[name] = value
        injectNumCurrent(name, value)
    else
        numCurrentKeepalive[name] = nil
        removeNumCurrent(name)
    end
end

