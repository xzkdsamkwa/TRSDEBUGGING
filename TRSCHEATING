addSection(playerPage, "World")
local hazardStatus
local hazardRemoved = {}   -- array of { inst =, parent = } in removal order
local hazardConn

local function isHazard(inst)
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then return false end
    for _, n in ipairs(CONFIG.HazardNames) do
        if inst.Name == n then return true end
    end
    return false
end

local function removeHazard(inst)
    pcall(function()
        if inst.Parent == nil then return end
        hazardRemoved[#hazardRemoved + 1] = { inst = inst, parent = inst.Parent }
        inst.Parent = nil -- kept alive by the table above, so it can be restored
    end)
end

addToggle(playerPage, "Remove Barbed Wire & Ragdoll Parts", false, function(v)
    flags.Hazards = v
    if v then
        for _, d in ipairs(workspace:GetDescendants()) do
            if isHazard(d) then removeHazard(d) end
        end
        hazardConn = workspace.DescendantAdded:Connect(function(d)
            if flags.Hazards and isHazard(d) then task.defer(removeHazard, d) end
        end)
    else
        if hazardConn then hazardConn:Disconnect() hazardConn = nil end
        for i = #hazardRemoved, 1, -1 do -- reverse order so nested ones go back inside their parents
            local r = hazardRemoved[i]
            pcall(function() r.inst.Parent = r.parent end)
        end
        table.clear(hazardRemoved)
        if hazardStatus then hazardStatus.Text = "Idle" end
    end
end)
