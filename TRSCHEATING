            if RevFarm.status then RevFarm.status.Text = "Idle" end
        end
    end)
    RevFarm.status = addLabel(revPage, "Idle")

    addSectionHelp(revPage, "Weapon", table.concat({
        "Pick the weapon to farm with. It is equipped automatically from your hand or backpack.",
        "",
        "Recommended: LAZARUS, Dragon Slayer, Azure Endbringer.",
        "",
        "Not in the list? Type the exact tool name in the box below the list and press Enter. It gets added and selected.",
        "",
        "Revenant deaths are sent to your Discord webhook (Misc > Settings, needs 'Use Webhook' on).",
    }, "\n"))

    local toolHolder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        LayoutOrder = nextLO(), Parent = revPage,
    }, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local function selectTool(name)
        RevFarm.tool = name
        local n = normName(name)
        for _, r in ipairs(RevFarm.rows) do
            r.btn.BackgroundColor3 = (r.norm == n) and T.accent or T.row
        end
    end

    local function addToolRow(name, rec, custom)
        local n = normName(name)
        for _, r in ipairs(RevFarm.rows) do
            if r.norm == n then return r end
        end
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = T.row, Text = "", AutoButtonColor = false,
            LayoutOrder = #RevFarm.rows + 1, Parent = toolHolder,
        }, { corner(6) })
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0), Text = name,
            TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
        })
        if rec then
            new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(96, 16),
                BackgroundColor3 = T.on, Text = "RECOMMENDED", TextColor3 = Color3.new(1, 1, 1),
                Font = Enum.Font.GothamBold, TextSize = 10, Parent = btn,
            }, { corner(4) })
        elseif custom then
            new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(60, 16),
                BackgroundColor3 = T.off, Text = "CUSTOM", TextColor3 = T.text,
                Font = Enum.Font.GothamBold, TextSize = 10, Parent = btn,
            }, { corner(4) })
        end
        local row = { name = name, norm = n, btn = btn }
        RevFarm.rows[#RevFarm.rows + 1] = row
        if custom then RevFarm.custom[n] = true end
        track(btn.Activated:Connect(function() selectTool(name) end))
        return row
    end

    for _, t in ipairs(CONFIG.RevenantTools) do addToolRow(t.name, t.rec, false) end
    selectTool(RevFarm.tool)

    local customBox
    customBox = addTextbox(revPage, "Custom tool name (Enter to add)", function(t)
        local name = t:match("^%s*(.-)%s*$")
        customBox.Text = ""
        if not name or name == "" then return end
        addToolRow(name, false, true)
        selectTool(name)
    end)

    addSection(revPage, "Aim")
    addToggle(revPage, "Aim at head (headshot multiplier)", true, function(v) RevFarm.head = v end)
    local bodyBtn
    bodyBtn = addButton(revPage, "Body target (head aim off): Torso", function()
        RevFarm.body = (RevFarm.body == "Torso") and "HumanoidRootPart" or "Torso"
        bodyBtn.Text = ("Body target (head aim off): %s"):format(RevFarm.body)
    end)
    addToggle(revPage, "Face target + lock camera", true, function(v)
        RevFarm.camAim = v
        if not v then releaseRevCamera() end
    end)
    local distSlider
    distSlider = addSlider(revPage, "Distance", 3, 20, RevFarm.dist, function(v)
        RevFarm.dist = v
        distSlider.Label.Text = ("Distance: %d studs"):format(v)
    end)
    distSlider.Label.Text = ("Distance: %d studs"):format(RevFarm.dist)

    ---------------- teleport: stay in front of the target part, looking at it ----------------
    track(RunService.Heartbeat:Connect(function()
        if not flags.RevFarm then return end
        local hrp = getHRP()
        local m = RevFarm.target
        if not hrp or not m or not m:IsDescendantOf(workspace) then return end
        local part = revPartFor(m)
        if not part then return end

        local tpos = part.Position
        local flat = Vector3.new(hrp.Position.X - tpos.X, 0, hrp.Position.Z - tpos.Z)
        if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, 1) end
        local p = tpos + flat.Unit * RevFarm.dist
        local pos = Vector3.new(p.X, tpos.Y + CONFIG.RevFarmYOffset, p.Z)

        hrp.CFrame = CFrame.lookAt(pos, Vector3.new(tpos.X, pos.Y, tpos.Z))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end))

    ---------------- camera: look straight at the target part ----------------
    local function camStep()
        if not flags.RevFarm or not RevFarm.camAim then return end
        local cam = workspace.CurrentCamera
        local hrp = getHRP()
        local m = RevFarm.target
        local part = m and m:IsDescendantOf(workspace) and revPartFor(m)
        if not (cam and hrp and part) then
            releaseRevCamera()
            return
        end
        RevFarm.camHeld = true
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.lookAt(hrp.Position + Vector3.new(0, 1.5, 0), part.Position)
    end
    pcall(function() RunService:UnbindFromRenderStep("RevFarmCam") end)
    RunService:BindToRenderStep("RevFarmCam", Enum.RenderPriority.Camera.Value + 10, camStep)

    ---------------- main loop: pick target, equip, swing ----------------
    task.spawn(function()
        while alive do
            if flags.RevFarm then
                local ch = LP.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local hrp = getHRP()
                RevFarm.target = sortedRevenants(true)[1] -- nearest living revenant

                if not (hum and hrp and hum.Health > 0) then
                    RevFarm.status.Text = "Waiting for character..."
                    task.wait(0.5)
                else
                    local tool = findFarmTool()
                    if not tool then
                        RevFarm.status.Text = ('<font color="#ff5a5a">Tool "%s" not found (hand or backpack)</font>'):format(esc(RevFarm.tool))
                        task.wait(0.5)
                    elseif tool.Parent ~= ch then
                        RevFarm.status.Text = "Equipping " .. tool.Name
                        pcall(function() hum:EquipTool(tool) end)
                        task.wait(0.3)
                    else
                        local m = RevFarm.target
                        local part = revPartFor(m)
                        if not part then
                            RevFarm.status.Text = ("No revenant alive, waiting... (kills: %d)"):format(RevFarm.kills)
                            task.wait(0.25)
                        else
                            local dist = (part.Position - hrp.Position).Magnitude
                            if dist <= RevFarm.dist + 8 then
                                fireSignal(tool.Activated, function() tool:Activate() end)
                                task.wait(0.05)
                                fireSignal(tool.Deactivated, function() tool:Deactivate() end)
                            end
                            RevFarm.status.Text = ("%s -> %s (%d studs)\nTool: %s | kills: %d"):format(
                                esc(m.Name), esc(part.Name), math.floor(dist), esc(tool.Name), RevFarm.kills)
                            task.wait(CONFIG.AutoAttackInterval)
                        end
                    end
                end
            else
                task.wait(0.3)
            end
        end
    end)
end

