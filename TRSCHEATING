-- Slider (integer values, can be locked) --------------------------------
local function addSlider(parent, text, min, max, default, cb)
    local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.row, LayoutOrder = nextLO(), Parent = parent }, { corner(6) })
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 16), Text = text,
        TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
    })
    local bar = new("Frame", { Position = UDim2.new(0, 10, 0, 30), Size = UDim2.new(1, -20, 0, 6), BackgroundColor3 = T.off, Parent = holder }, { corner(3) })
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent, BorderSizePixel = 0, Parent = bar }, { corner(3) })
    local hit = new("TextButton", { Position = UDim2.new(0, 10, 0, 22), Size = UDim2.new(1, -20, 0, 22), BackgroundTransparency = 1, Text = "", Parent = holder })

    local obj = { Value = default, Locked = false, Label = lbl }
    function obj:Set(v, silent)
        v = math.clamp(math.floor(v + 0.5), min, max)
        self.Value = v
        fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
        if not silent then cb(v) end
    end
    function obj:SetLocked(l)
        self.Locked = l
        holder.BackgroundTransparency = l and 0.5 or 0
        fill.BackgroundColor3 = l and T.dim or T.accent
        lbl.TextColor3 = l and T.dim or T.text
    end

    local dragging = false
    local function fromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        obj:Set(min + rel * (max - min))
    end
    track(hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if obj.Locked then return end
            dragging = true
            fromX(i.Position.X)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            fromX(i.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    obj:Set(default, true)
    return obj
end

