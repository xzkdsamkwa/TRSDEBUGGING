-- Switches to the next available machine when:
--   * a win is detected, or
--   * the current machine's prompt stays disabled > LotteryDisabledTimeout.
-- While any machine is usable the lottery has PRIORITY over scrap farming;
-- when none is usable, the scrap farm gets its turn.
----------------------------------------------------------------------
local lotteryPage = addTab("Lottery", true)
local lotteryStatus
local LT = { won = false, lastAction = 0, wins = 0, rounds = 0 }

