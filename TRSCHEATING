local function findMachines()
    local list = {}
    for _, name in ipairs(CONFIG.LotteryNames) do
        local m = workspace:FindFirstChild(name, true)
        if m then list[#list + 1] = m end
    end
    return list
end

local function machineTrigger(m)
    local prompt = m:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then return "prompt", prompt end
    local cd = m:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then return "click", cd end
    return nil
end

local function machineAvailable(m)
    if not m:IsDescendantOf(workspace) then return false end
    local kind, obj = machineTrigger(m)
    if kind == "prompt" then return promptAvailable(obj) end
    return kind == "click"
end

-- returns tool, isHeld (any Tool whose name contains LotteryTicketMatch)
local function findTicket()
    local want = CONFIG.LotteryTicketMatch:lower()
    local function scan(container)
        if not container then return nil end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find(want, 1, true) then return t end
        end
        return nil
    end
    local held = scan(LP.Character)
    if held then return held, true end
    local inBag = scan(LP:FindFirstChildOfClass("Backpack"))
    if inBag then return inBag, false end
    return nil, false
end

local function waitForTicket(timeout)
    local t0 = tick()
    repeat
        local t = findTicket()
        if t then return t end
        task.wait(0.05)
    until tick() - t0 > timeout or not flags.Lottery or not alive
    return nil
end

local function equipTicket(t)
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not (ch and hum and hum.Health > 0) then return false end
    if t.Parent == ch then return true end
    pcall(function() hum:EquipTool(t) end)
    local t0 = tick()
    repeat task.wait(0.05) until t.Parent == ch or tick() - t0 > 1
    return t.Parent == ch
end

-- Win detection -----------------------------------------------------------
-- The script can't know how the game announces a win, so it listens for text
-- that matches CONFIG.LotteryWinMatch (new/changed GUI text + console output)
-- shortly after a fire/activation. Adjust LotteryWinMatch to the real message.
local function looksLikeWin(text)
    local t = tostring(text):lower()
    for _, s in ipairs(CONFIG.LotteryWinMatch) do
        if t:find(s, 1, true) then return true end
    end
    return false
end

local function onWinSignal(text)
    if not alive or not flags.Lottery or LT.won then return end
    if tick() - LT.lastAction > CONFIG.LotteryWinWindow then return end
    LT.won = true
    LT.wins += 1
    sendWebhook("Lottery won", {
        { name = "Player", value = LP.Name, inline = true },
        { name = "Message", value = tostring(text):sub(1, 200) },
        { name = "Wins (session)", value = tostring(LT.wins), inline = true },
    }, 0x46C86E)
end

local watchedText = setmetatable({}, { __mode = "k" })
local function watchText(d, isNew)
    if watchedText[d] or not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
    if d:IsDescendantOf(gui) then return end -- never watch our own panel
    watchedText[d] = true
    local function check()
        if alive and d.Text ~= "" and looksLikeWin(d.Text) then onWinSignal(d.Text) end
    end
    d:GetPropertyChangedSignal("Text"):Connect(check)
    if isNew then check() end
end

task.spawn(function()
    local pg = LP:WaitForChild("PlayerGui")
    for _, d in ipairs(pg:GetDescendants()) do watchText(d, false) end
    track(pg.DescendantAdded:Connect(function(d) watchText(d, true) end))
end)
track(LogService.MessageOut:Connect(function(msg)
    if looksLikeWin(msg) then onWinSignal(msg) end
end))

-- Main loop ---------------------------------------------------------------
task.spawn(function()
    local idx, disabledSince = 1, nil
    local tpTarget, lastTp = nil, 0

    -- teleports only if out of range, and never more than once per cooldown
    local function approach(m, cf, reach)
        local hrp = getHRP()
        if not (hrp and cf) then return end
        if (hrp.Position - cf.Position).Magnitude <= reach then return end
        if tpTarget == m and tick() - lastTp < CONFIG.LotteryTeleportCooldown then return end
        teleportTo(cf)
        tpTarget, lastTp = m, tick()
        task.wait(0.15)
    end

    local function nextAvailable(machines, from)
        for step = 1, #machines do
            local i = ((from - 1 + step) % #machines) + 1
            if machineAvailable(machines[i]) then return i end
        end
        return nil
    end

    while alive do
        if not flags.Lottery then
            Shared.lotteryReady = false
            disabledSince, tpTarget = nil, nil
            task.wait(0.3)
        else
            local machines = findMachines()
            if #machines == 0 then
                Shared.lotteryReady = false
                lotteryStatus.Text = "No Machine1/Machine2 found"
                task.wait(1)
            else
                if idx > #machines then idx = 1 end
                local m = machines[idx]

                -- the lottery keeps priority while ANY machine is usable
                local anyAvail = false
                for _, mm in ipairs(machines) do
                    if machineAvailable(mm) then anyAvail = true break end
                end
                Shared.lotteryReady = anyAvail

                if LT.won then
                    LT.won = false
                    local n = nextAvailable(machines, idx)
                    if n then idx = n end
                    disabledSince, tpTarget = nil, nil -- forces a teleport to the new machine
                    lotteryStatus.Text = ("Won! (%d wins) -> switching to %s"):format(LT.wins, machines[idx].Name)
                    task.wait(0.3)

                elseif not machineAvailable(m) then
                    disabledSince = disabledSince or tick()
                    local waited = tick() - disabledSince
                    lotteryStatus.Text = ("%s disabled (%.1fs / %ds)%s"):format(
                        m.Name, waited, CONFIG.LotteryDisabledTimeout, anyAvail and "" or " - none available, scrap farm has the turn")
                    if waited > CONFIG.LotteryDisabledTimeout then
                        local n = nextAvailable(machines, idx)
                        if n then
                            idx, disabledSince, tpTarget = n, nil, nil
                        end
                    end
                    task.wait(0.2)

                else
                    disabledSince = nil

                    -- let a running scrap collection release first (it aborts on its own)
                    local w0 = tick()
                    while Shared.farmBusy and tick() - w0 < 6 and alive and flags.Lottery do task.wait(0.05) end

                    local kind, obj = machineTrigger(m)
                    local cf = (kind == "prompt") and promptCFrame(obj, m)
                        or (partOf(m) and partOf(m).CFrame)
                    local reach = ((kind == "prompt" and obj.MaxActivationDistance) or 10) - 2
                    approach(m, cf, reach)

                    -- 1) fire the machine
                    lotteryStatus.Text = ("Firing %s (wins: %d)"):format(m.Name, LT.wins)
                    LT.lastAction = tick()
                    if kind == "prompt" then
                        firePrompt(obj)
                    elseif ENV.fireclickdetector then
                        ENV.fireclickdetector(obj)
                    end

                    -- 2) wait for the ticket it gives, equip + activate it
                    local ticket = waitForTicket(CONFIG.LotteryTicketWait)
                    if ticket then
                        if equipTicket(ticket) then
                            lotteryStatus.Text = ("Using %s (wins: %d)"):format(ticket.Name, LT.wins)
                            LT.lastAction = tick()
                            fireSignal(ticket.Activated, function() ticket:Activate() end)
                            task.wait(0.1)
                            fireSignal(ticket.Deactivated, function() ticket:Deactivate() end)
                            LT.rounds += 1
                        else
                            lotteryStatus.Text = "Couldn't equip the ticket"
                        end
                    else
                        lotteryStatus.Text = ("%s gave no ticket (prompt probably went on cooldown)"):format(m.Name)
                    end

                    -- 3) small pause, cut short if a win shows up
                    local t1 = tick()
                    while tick() - t1 < CONFIG.LotteryInterval and not LT.won and alive and flags.Lottery do
                        task.wait(0.05)
                    end
                end
            end
        end
    end
end)

