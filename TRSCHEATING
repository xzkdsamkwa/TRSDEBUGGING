local function track(c) conns[#conns + 1] = c return c end

local function new(class, props, children)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = o end
    if parent then o.Parent = parent end
    return o
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end

local function esc(s)
    return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function partOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function teleportTo(cf)
    local hrp = getHRP()
    if hrp then hrp.CFrame = cf + CONFIG.TeleportOffset end
end

-- Looks inside the instance first, then climbs up to 4 ancestors (scraps are
-- MeshParts inside a Model inside a Part, so the prompt may live higher up).
local function findPrompt(inst, stopAt)
    local cur = inst
    for _ = 0, 4 do
        if not cur or cur == workspace or cur == stopAt then break end
        local p = cur:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p then return p end
        cur = cur.Parent
    end
    return nil
end

local function promptCFrame(prompt, fallbackInst)
    local par = prompt and prompt.Parent
    if par and par:IsA("BasePart") then return par.CFrame end
    if par and par:IsA("Attachment") then return par.WorldCFrame end
    local p = partOf(fallbackInst)
    return p and p.CFrame
end

local function firePrompt(prompt)
    if ENV.fireproximityprompt then
        ENV.fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait((prompt.HoldDuration or 0) + 0.05)
        prompt:InputHoldEnd()
    end
end

local function promptAvailable(p)
    return p ~= nil and p.Parent ~= nil and p.Enabled and p:IsDescendantOf(workspace)
end

-- Camera helpers (used while holding a scrap prompt) --------------------
local function aimCamera(target)
    local cam = workspace.CurrentCamera
    local hrp = getHRP()
    if not cam or not hrp then return end
    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = CFrame.lookAt(hrp.Position + Vector3.new(0, 2, 0), target)
end

local function releaseCamera()
    local cam = workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
    end
end

local function attrText(inst)
    local keys = {}
    for k in pairs(inst:GetAttributes()) do keys[#keys + 1] = k end
    table.sort(keys)
    if #keys == 0 then return '<font color="#888888">(no attributes)</font>' end
    local out = {}
    for _, k in ipairs(keys) do
        out[#out + 1] = ('<font color="#9aa4ff">%s</font> = %s'):format(esc(k), esc(inst:GetAttribute(k)))
    end
    return table.concat(out, "\n")
end

