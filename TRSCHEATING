    for name, o in pairs(toggleReg) do data.toggles[name] = o.State end
    for name, o in pairs(sliderReg) do data.sliders[name] = o.Value end
    data.farm = { tool = RevFarm.tool, body = RevFarm.body, custom = RevFarm.customList }
    return data
end

local function applySaved(data, restoreFeatures)
    if type(data) ~= "table" then return end
    if type(data.settings) == "table" then
        for k, v in pairs(data.settings) do
            if S[k] ~= nil and type(S[k]) == type(v) then
                S[k] = v
                local o = settingsReg[k]
                if o then
                    if o.Kind == "slider" then o:Set(v) else o:Set(v, true) end
                end
            end
        end
    end
    do
        local ok, k = pcall(function() return Enum.KeyCode[S.ToggleKey] end)
        if ok and k then CONFIG.ToggleKey = k end
        Drink.key = nil
        if S.StaminaKey ~= "" then
            local ok2, k2 = pcall(function() return Enum.KeyCode[S.StaminaKey] end)
            if ok2 and k2 then Drink.key = k2 end
        end
    end
    if type(data.webhook) == "string" then
        webhookUrl = data.webhook
        if webhookBox then webhookBox.Text = webhookUrl end
    end
    if type(data.farm) == "table" then
        if type(data.farm.custom) == "table" then
            for _, n in ipairs(data.farm.custom) do
                if type(n) == "string" and n ~= "" then RevFarm.addToolRow(n, false, true) end
            end
        end
        if type(data.farm.tool) == "string" and data.farm.tool ~= "" then RevFarm.selectTool(data.farm.tool) end
        if type(data.farm.body) == "string" then RevFarm.setBody(data.farm.body) end
    end
    if restoreFeatures then
        if type(data.sliders) == "table" then
            for name, v in pairs(data.sliders) do
                local o = sliderReg[name]
                if o and type(v) == "number" then o:Set(v) end
            end
        end
        if type(data.toggles) == "table" then
            for name, v in pairs(data.toggles) do
                local o = toggleReg[name]
                if o and type(v) == "boolean" then o:Set(v, true) end
            end
        end
    end
    setTheme(S.Theme)
    applyLook()
    updateKeyLabels()
    themeRefresh()
end

local function refreshCfgStatus()
    if not cfgStatus then return end
    if not canSave then
        cfgStatus.Text = '<font color="#ff8a8a">Your executor has no file functions — saving is unavailable.</font>'
        return
    end
    local exists = false
    pcall(function() exists = ENV.isfile(CONFIG.ConfigFile) end)
    cfgStatus.Text = ("File: %s\nSaved config: %s"):format(CONFIG.ConfigFile, exists and "found" or "none yet")
end

local function saveConfig(silent)
    if not canSave then
        if not silent then notify("Your executor can't write files, so saving isn't available.", "error") end
        return false
    end
    local ok, err = pcall(function()
        ENV.writefile(CONFIG.ConfigFile, HttpService:JSONEncode(collectConfig()))
    end)
    if not silent then
        if ok then notify("Configuration saved", "success") else notify("Save failed: " .. esc(tostring(err)), "error") end
    end
    refreshCfgStatus()
    return ok
end

local function loadConfigFromDisk()
    if not canSave then notify("Your executor can't read files, so loading isn't available.", "error") return end
    local ok, data = pcall(function()
        if ENV.isfile(CONFIG.ConfigFile) then
            return HttpService:JSONDecode(ENV.readfile(CONFIG.ConfigFile))
        end
    end)
    if ok and type(data) == "table" then
        applySaved(data, true)
        notify("Configuration loaded", "success")
    else
        notify("No saved configuration found", "warn")
    end
end

local function resetConfigFile()
    if canSave and ENV.delfile and ENV.isfile(CONFIG.ConfigFile) then
        pcall(ENV.delfile, CONFIG.ConfigFile)
        notify("Saved configuration deleted", "warn")
    else
        notify("Nothing to delete", "neutral")
    end
    refreshCfgStatus()
end

