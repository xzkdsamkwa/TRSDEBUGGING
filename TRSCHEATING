    local function snapCC(cc)
        return { cc.Brightness, cc.Contrast, cc.Saturation, cc.TintColor }
    end

    local function snapshotsDiffer(a, b)
        return a[1] ~= b[1] or a[2] ~= b[2] or a[3] ~= b[3] or a[4] ~= b[4]
    end

    local function killRageColorCorrections()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local now = tick()
        local seen = {}
        for _, child in ipairs(cam:GetChildren()) do
            if child:IsA("ColorCorrectionEffect") then
                seen[child] = true
                local rec = rageCC.watched[child]
                if not rec then
                    rageCC.watched[child] = { snap = snapCC(child), changes = 0, seenAt = now }
                else
                    local newSnap = snapCC(child)
                    if snapshotsDiffer(rec.snap, newSnap) then
                        rec.changes += 1
                        rec.snap = newSnap
                    end
                    if now - rec.seenAt >= 1 and rec.changes >= 2 then
                        pcall(function() child:Destroy() end)
                        rageCC.watched[child] = nil
                        rageCC.removed += 1
                        seen[child] = nil
                    end
                end
            end
        end
        for cc in pairs(rageCC.watched) do
            if not seen[cc] then rageCC.watched[cc] = nil end
        end
    end

